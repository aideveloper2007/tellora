# FastAPI Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
ENVIRONMENT=development

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:5000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# API Keys (SET THESE BEFORE PRODUCTION)
CLAUDE_API_KEY=your_claude_api_key_here
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Mock Mode (set to False when Claude API is ready)
MOCK_LLM_MODE=True
MOCK_IMAGE_MODE=True

# Database (optional - for conversation storage)
DATABASE_URL=postgresql://user:password@localhost:5432/genai_themes

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/api.log

# Validation
MAX_PRD_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,docx,txt,md
TEMPLATE_MATCH_THRESHOLD=0.85
QUALITY_THRESHOLD=0.8
MAX_REFINEMENT_RETRIES=3

# Theme Generation
DEFAULT_TEMPLATE=template_modern_002
THEME_GENERATION_TIMEOUT_SECONDS=30
