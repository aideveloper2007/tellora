<div class="flex h-screen bg-gray-50" 
     data-controller="genai-chat"
     data-genai-chat-conversation-id-value="<%= @conversation_id %>">
  <!-- Chat Interface -->
  <div class="flex-1 flex flex-col">
    <!-- Header -->
    <div class="bg-white border-b border-gray-200 px-6 py-4">
      <div class="flex items-center justify-between flex-wrap gap-4">
        <div class="flex-shrink-0">
          <h1 class="text-2xl font-bold text-gray-900">AI Theme Designer</h1>
          <p class="text-sm text-gray-600">Chat to create your perfect theme</p>
        </div>
        <div class="flex items-center space-x-4 flex-wrap gap-2">
          <!-- LLM Toggle - Made more prominent -->
          <div class="flex items-center space-x-3 px-4 py-2 bg-blue-50 rounded-lg border-2 border-blue-300 shadow-sm">
            <span class="text-sm font-semibold text-gray-800">Mock LLM</span>
            <label class="relative inline-flex items-center cursor-pointer">
              <input 
                type="checkbox" 
                data-genai-chat-target="llmToggle"
                data-action="change->genai-chat#toggleLLM"
                checked
                class="sr-only peer">
              <div class="w-11 h-6 bg-gray-400 peer-focus:outline-none peer-focus:ring-4 peer-focus:ring-blue-300 rounded-full peer peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
            </label>
            <span class="text-sm font-semibold text-gray-800">
              <span data-genai-chat-target="llmLabel">Real LLM (Claude)</span>
            </span>
          </div>
          <button 
            data-action="click->genai-chat#uploadPRD"
            class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
            </svg>
            Upload PRD
          </button>
          <%= link_to genai_themes_path, class: "inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50" do %>
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
            </svg>
            Home
          <% end %>
        </div>
      </div>
    </div>

    <!-- Messages Container -->
    <div class="flex-1 overflow-y-auto px-6 py-4 space-y-4" data-genai-chat-target="messages">
      <!-- Welcome Message -->
      <div class="flex items-start space-x-3">
        <div class="flex-shrink-0">
          <div class="w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </div>
        </div>
        <div class="flex-1">
          <div class="bg-white rounded-lg shadow-sm p-4 border border-gray-200">
            <p class="text-sm font-semibold text-gray-900 mb-1">AI Assistant</p>
            <p class="text-gray-700">
              Welcome! I'm your AI theme designer. I can help you create a beautiful theme for your store. 
              You can either:
            </p>
            <ul class="mt-2 space-y-1 text-gray-700">
              <li>• Tell me about your store in a conversation</li>
              <li>• Upload a PRD document with your requirements</li>
              <li>• Provide store details directly for quick generation</li>
            </ul>
          </div>
          <!-- Suggestion Pills -->
          <div class="flex flex-wrap gap-2 mt-3">
            <button 
              data-action="click->genai-chat#sendSuggestion"
              data-message="I run a luxury jewelry store"
              class="px-3 py-1 bg-blue-50 text-blue-700 rounded-full text-sm hover:bg-blue-100 transition-colors">
              I run a luxury jewelry store
            </button>
            <button 
              data-action="click->genai-chat#sendSuggestion"
              data-message="I need a modern tech theme"
              class="px-3 py-1 bg-blue-50 text-blue-700 rounded-full text-sm hover:bg-blue-100 transition-colors">
              I need a modern tech theme
            </button>
            <button 
              data-action="click->genai-chat#sendSuggestion"
              data-message="Generate theme for fashion store"
              class="px-3 py-1 bg-blue-50 text-blue-700 rounded-full text-sm hover:bg-blue-100 transition-colors">
              Generate theme for fashion store
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Input Area -->
    <div class="bg-white border-t border-gray-200 px-6 py-4">
      <form data-action="submit->genai-chat#sendMessage" class="flex space-x-4">
        <input 
          type="text"
          data-genai-chat-target="input"
          placeholder="Type your message..."
          class="flex-1 rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
          autocomplete="off"
        />
        <button 
          type="submit"
          data-genai-chat-target="sendButton"
          class="inline-flex items-center px-6 py-2 border border-transparent rounded-lg shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 disabled:opacity-50 disabled:cursor-not-allowed">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
          </svg>
          Send
        </button>
      </form>
      
      <!-- Status Indicator -->
      <div data-genai-chat-target="status" class="mt-2 text-sm text-gray-500 hidden">
        <span class="inline-flex items-center">
          <svg class="animate-spin h-4 w-4 mr-2 text-blue-600" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span data-genai-chat-target="statusText">AI is thinking...</span>
        </span>
      </div>
    </div>
  </div>

  <!-- Sidebar - Extracted Info & Actions -->
  <div class="w-96 bg-white border-l border-gray-200 overflow-y-auto">
    <div class="p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Extracted Information</h2>
      
      <div data-genai-chat-target="extractedInfo" class="space-y-4">
        <div class="text-sm text-gray-500 italic">
          No information extracted yet. Start chatting to provide details about your store.
        </div>
      </div>

      <!-- Generate Button (shown when ready) -->
      <div data-genai-chat-target="generateSection" class="hidden mt-6 pt-6 border-t border-gray-200">
        <div class="bg-green-50 border border-green-200 rounded-lg p-4 mb-4">
          <div class="flex items-start">
            <svg class="w-5 h-5 text-green-600 mt-0.5 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            <div>
              <p class="text-sm font-medium text-green-900">Ready to Generate!</p>
              <p class="text-xs text-green-700 mt-1">I have enough information to create your theme.</p>
            </div>
          </div>
        </div>
        
        <button 
          data-action="click->genai-chat#generateTheme"
          class="w-full inline-flex justify-center items-center px-6 py-3 border border-transparent rounded-lg shadow-sm text-base font-medium text-white bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
          Generate Theme Now
        </button>
      </div>
    </div>
  </div>

  <!-- Hidden File Upload Input -->
  <input 
    type="file" 
    data-genai-chat-target="fileInput"
    data-action="change->genai-chat#handleFileUpload"
    accept=".pdf,.docx,.txt,.md"
    class="hidden"
  />

  <!-- Loading Modal -->
  <div data-genai-chat-target="loadingModal" class="hidden fixed inset-0 bg-gray-600 bg-opacity-75 flex items-center justify-center z-50">
    <div class="bg-white rounded-lg p-8 max-w-md w-full mx-4">
      <div class="text-center">
        <svg class="animate-spin h-16 w-16 text-blue-600 mx-auto mb-4" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <h3 class="text-lg font-semibold text-gray-900 mb-2" data-genai-chat-target="loadingTitle">
          Generating Your Theme
        </h3>
        <p class="text-gray-600" data-genai-chat-target="loadingMessage">
          This may take 20-30 seconds...
        </p>
        <div class="mt-4">
          <div class="w-full bg-gray-200 rounded-full h-2">
            <div data-genai-chat-target="progressBar" class="bg-blue-600 h-2 rounded-full transition-all duration-500" style="width: 0%"></div>
          </div>
          <p class="text-sm text-gray-500 mt-2">
            <span data-genai-chat-target="progressText">Starting...</span>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
