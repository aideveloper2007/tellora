<div class="card mb-4">
  <div class="card-header">
    <h5 class="mb-0">Enquiry Settings</h5>
  </div>
  <div class="card-body">
    <div class="form-group">
      <div class="form-check">
        <%= f.hidden_field :enquiry_mode, value: "0" %>
        <%= f.check_box :enquiry_mode, { class: 'form-check-input', id: 'product_enquiry_mode' }, "1", "0" %>
        <%= f.label :enquiry_mode, "Enable Enquiry Mode", class: 'form-check-label' %>
        <small class="form-text text-muted">
          When enabled, this product will show "Enquiry" button instead of "Add to Cart"
        </small>
      </div>
    </div>
    
    <div class="form-group mt-3" id="custom_enquiry_url_field">
      <%= f.label :custom_enquiry_url, "Custom Enquiry URL (Optional)" %>
      <%= f.text_field :custom_enquiry_url, 
          class: 'form-control', 
          placeholder: 'https://example.com/enquiry' %>
      <small class="form-text text-muted">
        Leave blank to use default enquiry page. Include full URL with https://
      </small>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const checkbox = document.querySelector('input[name="product[enquiry_mode]"][type="checkbox"]');
  const urlField = document.getElementById('custom_enquiry_url_field');
  
  function toggle() {
    if (checkbox && urlField) {
      console.log('Checkbox checked:', checkbox.checked); // Debug line
      if (checkbox.checked) {
        urlField.style.display = 'block';
      } else {
        urlField.style.display = 'none';
      }
    }
  }
  
  if (checkbox && urlField) {
    // Force initial state based on checkbox
    if (checkbox.checked) {
      urlField.style.display = 'block';
    } else {
      urlField.style.display = 'none';
    }
    
    checkbox.addEventListener('change', toggle);
  }
});

// Also handle Turbo navigation
document.addEventListener('turbo:load', function() {
  const checkbox = document.querySelector('input[name="product[enquiry_mode]"][type="checkbox"]');
  const urlField = document.getElementById('custom_enquiry_url_field');
  
  if (checkbox && urlField) {
    if (checkbox.checked) {
      urlField.style.display = 'block';
    } else {
      urlField.style.display = 'none';
    }
  }
});
</script>