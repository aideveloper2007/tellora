
<%= render 'header' %>
<%= render_admin_partials(:order_page_header_partials, order: @order) %>

<div class="container px-0">
  <div class="row">
    <div class="col-lg-8">
      <%= render 'line_items' %>
      <%= render 'shipments' %>
      <%= render 'customer_returns' %>
      <%= render 'return_authorizations' %>
      <%= render 'payments'%>
      <%= render 'refunds'%>
      <%= render_admin_partials(:order_page_body_partials, order: @order) %>
      <%= render 'summary' %>
    </div>
    <div class="col-lg-4">
      <%= render 'customer' %>
      <%= render 'special_instructions' %>
      <%= render_admin_partials(:order_page_sidebar_partials, order: @order) %>
     <div style="border: 1px solid #e5e7eb; 
            border-radius: 8px; 
            padding: 12px; 
            background-color: #ffffff; 
            margin-top: 10px;">

        <!-- Heading -->
        <div class="card-header">
          <h5 class="card-title">
            Download
          </h5>
        </div
        <!-- Buttons -->
        <div style="display: flex; gap: 10px;">
          <%= link_to "Invoice",
                       spree.invoice_admin_order_path(@order),
                      class: "btn btn-sm btn-primary flex-fill" %>

          <%= link_to "Packaging Slip",
                      spree.packaging_slip_admin_order_path(@order),
                      class: "btn btn-sm btn-primary flex-fill" %>
        </div>

      </div>
    </div>   
  </div>
</div>