<% content_for :title, "Prove you own #{@import['domain']} | #{platform_name}" %>
<% record_name = ImportOwnership.record_name(@import['domain']) %>
<% record_value = ImportOwnership.record_value(@import['token']) %>
<% simple_domain = @import['domain'].to_s.count('.') == 1 %>
<% content_for :head do %>
<style>
  .move { padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(3rem, 7vw, 5rem); }
  .move .wrap { max-width: 50rem; }
  .move-steps { display: flex; gap: .5rem; flex-wrap: wrap; margin: 0 0 1.5rem; padding: 0; list-style: none; font-size: .8rem; font-weight: 600; }
  .move-steps li { padding: .35rem .75rem; border-radius: 999px; background: var(--mist); color: var(--muted); }
  .move-steps li.done { background: #fff1ea; color: var(--ember); }
  .move-steps li[aria-current] { background: var(--ink); color: #fff; }
  .move h1 { font-size: clamp(1.9rem, 4vw, 2.6rem); font-weight: 800; }
  .move-lede { margin-top: .9rem; color: var(--muted); font-size: 1.08rem; line-height: 1.55; }

  .record { margin-top: 2rem; background: #fff; border: 1px solid var(--line); border-radius: var(--radius-l); overflow: hidden; }
  .record-row { display: grid; grid-template-columns: 7rem minmax(0, 1fr) auto; gap: 1rem; align-items: center; padding: 1rem 1.25rem; border-bottom: 1px solid var(--line); }
  .record-row:last-child { border-bottom: 0; }
  .record-row dt { font-size: .8rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .record-row dd { margin: 0; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: .95rem; word-break: break-all; }
  .record-row dd small { display: block; margin-top: .25rem; font-family: var(--font-body); font-size: .8rem; color: var(--muted); word-break: normal; }
  .copy { border: 1px solid var(--line); background: var(--paper); border-radius: 8px; padding: .45rem .75rem; font: 600 .8rem var(--font-body); cursor: pointer; }
  .copy:hover { background: var(--mist); }
  @media (max-width: 560px) { .record-row { grid-template-columns: 1fr auto; } .record-row dt { grid-column: 1 / -1; } }

  .help { margin-top: 1.5rem; display: grid; gap: .6rem; }
  .help details { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: .9rem 1.1rem; }
  .help summary { cursor: pointer; font-weight: 600; }
  .help p { margin-top: .6rem; color: var(--muted); line-height: 1.55; font-size: .95rem; }

  .actions { margin-top: 2rem; display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; }
  .actions a { color: var(--muted); font-size: .92rem; }
  .move .flash { margin-top: 1.5rem; }
</style>
<% end %>

<section class="move" aria-labelledby="verify-title">
  <div class="wrap">
    <ol class="move-steps" aria-label="Steps">
      <li class="done">1. Your store</li>
      <li aria-current="step">2. Prove it's yours</li>
      <li>3. Your account</li>
    </ol>
    <h1 id="verify-title">Prove you own <%= @import['domain'] %></h1>
    <p class="move-lede">Add this one DNS record where you manage your domain (GoDaddy, Namecheap, Cloudflare, Hostinger or similar). It doesn't change your current store. It only shows us the domain is yours, so nobody else can copy your brand.</p>

    <% if flash[:alert] %><p class="flash" role="alert"><%= flash[:alert] %></p><% end %>

    <dl class="record">
      <div class="record-row">
        <dt>Type</dt>
        <dd>TXT</dd>
        <span></span>
      </div>
      <div class="record-row">
        <dt>Name / Host</dt>
        <% if simple_domain %>
          <dd>_tellora<small>Some providers want the full name: <%= record_name %></small></dd>
          <button type="button" class="copy" data-copy="_tellora">Copy</button>
        <% else %>
          <dd><%= record_name %><small>Most providers add your main domain by themselves: enter only the part before it.</small></dd>
          <button type="button" class="copy" data-copy="<%= record_name %>">Copy</button>
        <% end %>
      </div>
      <div class="record-row">
        <dt>Value</dt>
        <dd><%= record_value %></dd>
        <button type="button" class="copy" data-copy="<%= record_value %>">Copy</button>
      </div>
      <div class="record-row">
        <dt>TTL</dt>
        <dd style="font-family: var(--font-body)">Default (or 600 seconds)</dd>
        <span></span>
      </div>
    </dl>

    <div class="help">
      <details>
        <summary>GoDaddy</summary>
        <p>My Products → your domain → DNS → Add New Record. Type: TXT, Name: _tellora, Value: the value above. Save.</p>
      </details>
      <details>
        <summary>Cloudflare</summary>
        <p>Your domain → DNS → Records → Add record. Type: TXT, Name: _tellora, Content: the value above. Save.</p>
      </details>
      <details>
        <summary>Shopify-managed domain</summary>
        <p>Shopify admin → Settings → Domains → your domain → Domain settings → Edit DNS settings → Add custom record → TXT. Name: _tellora, Value: the value above.</p>
      </details>
    </div>

    <div class="actions">
      <%= button_to 'I added it, check now', platform_import_verify_path, method: :post, class: 'button', form: { data: { turbo: false } } %>
      <a href="<%= platform_import_path %>">Use a different address</a>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('[data-copy]').forEach(function (button) {
    button.addEventListener('click', function () {
      var text = button.getAttribute('data-copy');
      var done = function () { button.textContent = 'Copied'; setTimeout(function () { button.textContent = 'Copy'; }, 1500); };
      if (navigator.clipboard) { navigator.clipboard.writeText(text).then(done, function () {}); }
    });
  });
</script>
