<% content_for :title, "Move your store to #{platform_name}" %>
<% content_for :head do %>
<style>
  .move { padding: clamp(2.5rem, 6vw, 4.5rem) 0 clamp(3rem, 7vw, 5rem); }
  .move .wrap { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  @media (max-width: 860px) { .move .wrap { grid-template-columns: 1fr; } }
  .move-steps { display: flex; gap: .5rem; flex-wrap: wrap; margin-bottom: 1.5rem; padding: 0; list-style: none; font-size: .8rem; font-weight: 600; }
  .move-steps li { padding: .35rem .75rem; border-radius: 999px; background: var(--mist); color: var(--muted); }
  .move-steps li[aria-current] { background: var(--ink); color: #fff; }
  .move h1 { font-size: clamp(2rem, 4vw, 2.8rem); font-weight: 800; }
  .move-lede { margin-top: .9rem; color: var(--muted); font-size: 1.1rem; line-height: 1.55; }
  .brings { margin: 1.75rem 0 0; padding: 0; list-style: none; display: grid; gap: .7rem; }
  .brings li { display: flex; gap: .7rem; align-items: flex-start; line-height: 1.45; }
  .brings li::before { content: ''; flex: none; margin-top: .45rem; width: .5rem; height: .5rem; border-radius: 50%; background: var(--ember); }
  .platforms { margin-top: 1.75rem; display: flex; flex-wrap: wrap; gap: .45rem; }
  .platforms span { font-size: .8rem; font-weight: 600; padding: .4rem .75rem; border-radius: 999px; background: #fff; border: 1px solid var(--line); }
  .note { margin-top: 1.5rem; font-size: .9rem; color: var(--muted); line-height: 1.55; }

  .form-card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius-l); padding: clamp(1.25rem, 3vw, 2rem); box-shadow: 0 30px 60px -35px rgba(0,0,0,.25); }
  .form-card h2 { font-size: 1.35rem; font-weight: 700; }
  .form-card p.small { margin-top: .4rem; color: var(--muted); font-size: .92rem; }
  .field { margin: 1.25rem 0; }
  .field label { display: block; font-weight: 600; margin-bottom: .4rem; }
  .field input { width: 100%; font: 400 1.05rem/1.4 var(--font-body); color: var(--ink); padding: .85rem 1rem; border: 1px solid var(--line); border-radius: 12px; background: var(--paper); }
  .field input:focus { outline: 3px solid rgba(255,90,31,.35); outline-offset: 1px; border-color: var(--ember); }
  .form-card .button { width: 100%; }
</style>
<% end %>

<section class="move" aria-labelledby="move-title">
  <div class="wrap">
    <div>
      <ol class="move-steps" aria-label="Steps">
        <li aria-current="step">1. Your store</li>
        <li>2. Prove it's yours</li>
        <li>3. Your account</li>
      </ol>
      <h1 id="move-title">Move your store to <%= platform_name %></h1>
      <p class="move-lede">Already selling online? Tellora reads your current store and rebuilds it on a premium Tellora design, with your brand.</p>

      <ul class="brings">
        <li>Your logo, brand colour and fonts</li>
        <li>Your headlines, story and wording, in your language</li>
        <li>Your own photos on the home page</li>
        <li>Later, the same web address: connect your domain and your customers won't notice the move</li>
      </ul>

      <div class="platforms" aria-label="Works with">
        <span>Shopify</span><span>WooCommerce</span><span>Shoper</span><span>Wix</span><span>Squarespace</span><span>BigCommerce</span><span>Any website</span>
      </div>

      <p class="note">We rebuild your look; we don't copy your old theme's code. Your current store keeps working until you switch your domain.</p>
    </div>

    <div class="form-card">
      <h2>Where is your store now?</h2>
      <p class="small">Your own domain, the one your customers use.</p>

      <% if flash[:alert] %><p class="flash" role="alert" style="margin-top:1rem"><%= flash[:alert] %></p><% end %>

      <%= form_with url: platform_import_path, method: :post, data: { turbo: false } do %>
        <div class="field">
          <label for="address">Store web address</label>
          <input id="address" name="address" type="text" inputmode="url" autocapitalize="none" spellcheck="false"
                 required maxlength="200" placeholder="mybrand.com" value="<%= @address %>">
        </div>
        <button type="submit" class="button">Continue →</button>
      <% end %>
    </div>
  </div>
</section>
