    function cardsHtml(list, built) {
      return list.map(function (p, i) {
        return '<div class="s-card' + (built ? '' : '') + '"' + (built ? '' : ' data-step="' + (3 + i) + '"') + '><div class="s-img"></div><span class="s-name">' + p[0] + '</span><span class="s-price">' + p[1] + '</span></div>';
      }).join('');
    }

    /* ---------- hero store machine ---------- */
    var store = document.getElementById('m-store'), grid = document.getElementById('m-grid');
    var typeEl = document.getElementById('type-text'), host = document.getElementById('m-host'), url = document.getElementById('m-url');
    var live = document.getElementById('m-live'), timeEl = document.getElementById('m-time'), scan = document.getElementById('m-scan');
    var logItems = [].slice.call(document.querySelectorAll('#m-log li'));
    var timers = [], tick = null, current = 0;
    function later(fn, ms) { timers.push(setTimeout(fn, ms)); }
    function stop() { timers.forEach(clearTimeout); timers = []; clearInterval(tick); }

    function finished(demo) {
      [].forEach.call(store.querySelectorAll('[data-step]'), function (n) { n.classList.add('in'); });
      logItems.forEach(function (li) { li.className = 'done'; });
      url.classList.add('secure'); host.textContent = demo.slug + '.' + DOMAIN;
      live.classList.add('on'); timeEl.textContent = '58.0s'; typeEl.textContent = demo.prompt;
    }

    function run(i) {
      stop();
      current = i;
      var demo = DEMOS[i];
      applyFamily(store, demo.family);
      document.getElementById('m-logo').textContent = demo.logo;
      document.getElementById('m-tag').textContent = demo.tag;
      grid.innerHTML = cardsHtml(demo.products, false);
      [].forEach.call(document.querySelectorAll('#chips .chip'), function (c, j) { c.setAttribute('aria-pressed', j === i ? 'true' : 'false'); });
      if (reduceMotion) { finished(demo); return; }

      [].forEach.call(store.querySelectorAll('[data-step]'), function (n) { n.classList.remove('in'); });
      live.classList.remove('on'); url.classList.remove('secure'); host.textContent = 'building…';
      logItems.forEach(function (li) { li.className = ''; });
      timeEl.textContent = '0.0s'; typeEl.textContent = '';

      var chars = demo.prompt.split('');
      chars.forEach(function (c, n) { later(function () { typeEl.textContent += c; }, 400 + n * 32); });
      var start = 400 + chars.length * 32 + 350;

      later(function () {
        var s = Date.now();
        tick = setInterval(function () { timeEl.textContent = Math.min((Date.now() - s) / 1000 * 11.5, 58).toFixed(1) + 's'; }, 60);
        scan.classList.remove('run'); void scan.offsetWidth; scan.classList.add('run');
      }, start);

      var steps = [
        function () { store.querySelector('[data-step="1"]').classList.add('in'); },
        function () { store.querySelector('[data-step="2"]').classList.add('in'); },
        function () { store.querySelector('[data-step="3"]').classList.add('in'); store.querySelector('[data-step="4"]').classList.add('in'); },
        function () { store.querySelector('[data-step="5"]').classList.add('in'); },
        function () { url.classList.add('secure'); host.textContent = demo.slug + '.' + DOMAIN; }
      ];
      steps.forEach(function (fn, n) {
        later(function () { if (n > 0) logItems[n - 1].className = 'done'; logItems[n].className = 'active'; }, start + n * 900);
        later(fn, start + n * 900 + 500);
      });
      later(function () { logItems[4].className = 'done'; clearInterval(tick); timeEl.textContent = '58.0s'; live.classList.add('on'); }, start + 5 * 900);
      later(function () { run((current + 1) % DEMOS.length); }, start + 5 * 900 + 3200);
    }

    /* ---------- example chips: fill the prompt and build that store ---------- */
    var chipsEl = document.getElementById('chips'), promptEl = document.getElementById('prompt');
    DEMOS.forEach(function (demo, i) {
      var li = document.createElement('li');
      var b = document.createElement('button');
      b.type = 'button'; b.className = 'chip'; b.textContent = demo.chip;
      b.addEventListener('click', function () { promptEl.value = demo.prompt; run(i); });
      li.appendChild(b); chipsEl.appendChild(li);
    });
    run(0);

    /* ---------- design family tabs ---------- */
    var tabs = document.getElementById('tabs'), shStore = document.getElementById('sh-store');
    function show(i) {
      var d = DEMOS[i], f = FAMILIES[d.family];
      applyFamily(shStore, d.family);
      document.getElementById('sh-host').textContent = d.slug + '.' + DOMAIN;
      document.getElementById('sh-logo').textContent = d.logo;
      document.getElementById('sh-tag').textContent = d.tag;
      document.getElementById('sh-grid').innerHTML = cardsHtml(d.products, true);
      document.getElementById('sh-name').textContent = f.name;
      document.getElementById('sh-desc').textContent = f.desc;
      document.getElementById('sh-fits').innerHTML = f.fits.map(function (x) { return '<li>' + x + '</li>'; }).join('');
      document.getElementById('sh-sw').innerHTML = f.sw.map(function (c) { return '<span style="background:' + c + '"></span>'; }).join('');
      [].forEach.call(tabs.children, function (t, j) { t.setAttribute('aria-selected', j === i ? 'true' : 'false'); });
    }
    DEMOS.forEach(function (d, i) {
      var b = document.createElement('button');
      b.type = 'button'; b.className = 'tab'; b.setAttribute('role', 'tab'); b.textContent = FAMILIES[d.family].name;
      b.addEventListener('click', function () { show(i); });
      tabs.appendChild(b);
    });
    show(0);

    /* ---------- pricing: visitor's currency (rupees in India), switchable ---------- */
    (function () {
      var buttons = document.querySelectorAll('.currency [data-currency]');
      if (!buttons.length) return;
      function pick(code) {
        document.querySelectorAll('[data-price]').forEach(function (el) { el.hidden = el.getAttribute('data-price') !== code; });
        buttons.forEach(function (b) { b.setAttribute('aria-pressed', b.getAttribute('data-currency') === code ? 'true' : 'false'); });
        try { localStorage.setItem('tellora-currency', code); } catch (e) {}
      }
      var saved = null, zone = '';
      try { saved = localStorage.getItem('tellora-currency'); } catch (e) {}
      try { zone = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}
      var want = saved || ((zone === 'Asia/Kolkata' || zone === 'Asia/Calcutta') ? 'INR' : 'USD');
      if (!document.querySelector('.currency [data-currency="' + want + '"]')) want = buttons[0].getAttribute('data-currency');
      pick(want);
      buttons.forEach(function (b) { b.addEventListener('click', function () { pick(b.getAttribute('data-currency')); }); });
    })();

    /* ---------- "Start free" buttons focus the prompt ---------- */
    document.querySelectorAll('[data-start-free]').forEach(function (a) {
      a.addEventListener('click', function () {
        setTimeout(function () { promptEl.focus({ preventScroll: true }); }, reduceMotion ? 0 : 450);
      });
    });

    /* ---------- reveal on scroll ---------- */
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { e.target.classList.add(e.target.id === 'pipe' ? 'go' : 'seen'); io.unobserve(e.target); }
        });
      }, { threshold: 0.15 });
      document.querySelectorAll('.reveal, #pipe').forEach(function (el) { io.observe(el); });
    } else {
      document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('seen'); });
      document.getElementById('pipe').classList.add('go');
    }
  })();
</script>