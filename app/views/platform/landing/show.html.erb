<section class="section section-mist" id="questions" aria-labelledby="questions-title">
  <div class="wrap">
    <h2 id="questions-title">Questions</h2>
    <div class="faq">
      <details>
        <summary>Is it really free for <%= TelloraPlans.trial_months %> months?</summary>
        <p>Yes. You get every feature for <%= TelloraPlans.trial_months %> months without paying and without adding a card. Before the free period ends, we remind you to choose a plan. If you don't, your store pauses; nothing is deleted, and choosing a plan brings it back.</p>
      </details>
      <details>
        <summary>How does billing work after the free period?</summary>
        <p>You pay once every <%= TelloraPlans.billing_months %> months for the plan you choose. You can move to a bigger or smaller plan whenever you need to, and there is no fee on your sales on any plan.</p>
      </details>
      <details>
        <summary>What counts as a home page theme change?</summary>
        <p>A new AI design for your home page, or switching to a different style family. Changing your text, photos, products, logo and colours is free and unlimited on every plan.</p>
      </details>
      <details>
        <summary>Do I need design or coding skills?</summary>
        <p>No. You describe your business in your own words and the store is built for you. Later changes work the same way: you ask, and the AI makes them.</p>
      </details>
      <details>
        <summary>Which languages can I use?</summary>
        <p>Any language you can write in. Describe your store in the language that comes naturally; the AI understands it.</p>
      </details>
      <details>
        <summary>Can I change the design after the store is built?</summary>
        <p>Yes. Open the AI designer, say what you want changed, preview the result and apply it when you are happy. You can also go back to the standard design at any time.</p>
      </details>
      <details>
        <summary>What happens to the sample products?</summary>
        <p>They are there to show how your store will look. Each one is marked as a sample, so you can delete them all once you add your own products.</p>
      </details>
      <details>
        <summary>Can I use my own domain?</summary>
        <p>Yes. Your store starts on its own address, and you can connect a domain you already own whenever you are ready.</p>
      </details>
      <details>
        <summary>Who owns my store's data?</summary>
        <p>You do. Each store's products, orders and customers are kept in their own separate space, apart from every other store on the platform.</p>
      </details>
    </div>
  </div>
</section>

<section class="section closing" aria-labelledby="closing-title">
  <div class="wrap">
    <h2 id="closing-title">Your store is one sentence away</h2>
    <p class="section-intro">Describe what you sell. You can change everything afterwards.</p>
    <a class="button" href="#build" id="closing-cta">Describe my business</a>
  </div>
</section>

<script>
  (function () {
    var DOMAIN = <%= raw preview_domain.to_json %>;

    // Example stores from around the world. Prompts are written in local languages on purpose.
    var EXAMPLES = [
      { chip: 'Ceramics, Kyoto', prompt: '京都の手作り陶器スタジオ。茶碗、花瓶、酒器を販売しています。', name: 'Kiln & Clay', slug: 'kiln-and-clay',
        tagline: 'Slow-made ceramics for everyday tea', locale: 'ja-JP', currency: 'JPY',
        colors: { bg: '#f4f1ec', ink: '#2a2826', accent: '#3d4f6e', band: '#e3ddd3' }, font: "Georgia, 'Times New Roman', serif",
        products: [['Tea bowl, ash glaze', 6800, 'circle'], ['Bud vase', 9200, 'pill'], ['Sake cup pair', 5400, 'arch'], ['Incense stand', 2600, 'diamond']] },
      { chip: 'Spices, Kerala', prompt: 'Organic spice farm in Kerala selling cardamom, black pepper and turmeric directly to home cooks', name: 'Malabar Harvest', slug: 'malabar-harvest',
        tagline: 'Spices picked on our farm, packed the same week', locale: 'en-IN', currency: 'INR',
        colors: { bg: '#fbf7ec', ink: '#24301e', accent: '#2f6b3a', band: '#f0ddb0' }, font: "'Trebuchet MS', 'Segoe UI', sans-serif",
        products: [['Green cardamom', 449, 'leaf'], ['Tellicherry pepper', 329, 'circle'], ['Wild turmeric', 249, 'arch'], ['Spice gift box', 1299, 'diamond']] },
      { chip: 'Streetwear, Lagos', prompt: 'Bold streetwear brand from Lagos: graphic tees, hoodies and caps for young people', name: 'Eko Thread', slug: 'eko-thread',
        tagline: 'Made in Lagos. Worn everywhere.', locale: 'en-NG', currency: 'NGN',
        colors: { bg: '#121212', ink: '#f5f5f0', accent: '#ff5a1f', band: '#262626' }, font: "Impact, 'Arial Narrow', sans-serif",
        products: [['Graphic tee', 18500, 'diamond'], ['Heavy hoodie', 42000, 'arch'], ['Five-panel cap', 12000, 'circle'], ['Tote bag', 9500, 'pill']] },
      { chip: 'Cheese, Lyon', prompt: 'Fromagerie artisanale à Lyon : fromages affinés, plateaux et coffrets cadeaux', name: 'Fromagerie Lumière', slug: 'fromagerie-lumiere',
        tagline: 'Fromages affinés à Lyon depuis trois générations', locale: 'fr-FR', currency: 'EUR',
        colors: { bg: '#fffdf6', ink: '#3b2f1e', accent: '#8a1c2b', band: '#f3e7c4' }, font: "'Palatino Linotype', Palatino, Georgia, serif",
        products: [['Comté 24 mois', 12.9, 'diamond'], ['Saint-Marcellin', 6.5, 'circle'], ['Plateau découverte', 34, 'arch'], ['Coffret cadeau', 49, 'pill']] },
      { chip: 'Coffee, Bogotá', prompt: 'Tostadora de café de especialidad en Bogotá, cafés de origen único y suscripciones mensuales', name: 'Cerro Tostado', slug: 'cerro-tostado',
        tagline: 'Café de origen, tostado esta semana', locale: 'es-CO', currency: 'COP',
        colors: { bg: '#f7f0e8', ink: '#2e1d14', accent: '#b4532a', band: '#e9d3bf' }, font: "'Gill Sans', 'Segoe UI', sans-serif",
        products: [['Huila 340 g', 42000, 'leaf'], ['Nariño 340 g', 46000, 'circle'], ['Suscripción mensual', 120000, 'arch'], ['Prensa francesa', 98000, 'pill']] },
      { chip: 'Surf, Sydney', prompt: 'Surf shop on Sydney\'s northern beaches selling boards, wetsuits and lessons', name: 'Saltline Surf', slug: 'saltline-surf',
        tagline: 'Boards and wetsuits for the northern beaches', locale: 'en-AU', currency: 'AUD',
        colors: { bg: '#eef7f8', ink: '#0f2e3a', accent: '#0a7ea4', band: '#cfe9ee' }, font: "Verdana, 'Segoe UI', sans-serif",
        products: [['Soft-top 7 ft', 449, 'pill'], ['3/2 wetsuit', 329, 'arch'], ['Wax pack', 12, 'circle'], ['Group lesson', 75, 'leaf']] }
    ];

    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var preview = document.getElementById('preview');
    var status = document.getElementById('build-status');
    var steps = status.querySelectorAll('li');
    var chipsEl = document.getElementById('chips');
    var promptEl = document.getElementById('prompt');
    var timers = [];

    function money(value, ex) {
      try { return new Intl.NumberFormat(ex.locale, { style: 'currency', currency: ex.currency, maximumFractionDigits: value % 1 ? 2 : 0 }).format(value); }
      catch (e) { return ex.currency + ' ' + value; }
    }

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; });
    }

    function paint(ex) {
      preview.style.setProperty('--p-bg', ex.colors.bg);
      preview.style.setProperty('--p-ink', ex.colors.ink);
      preview.style.setProperty('--p-accent', ex.colors.accent);
      preview.style.setProperty('--p-band', ex.colors.band);
      preview.style.setProperty('--p-font', ex.font);
      document.getElementById('p-url').textContent = 'https://' + ex.slug + '.' + DOMAIN;
      document.getElementById('p-name').textContent = ex.name;
      var tagline = document.getElementById('p-tagline');
      tagline.textContent = ex.tagline;
      tagline.lang = ex.locale.split('-')[0];
      document.getElementById('p-grid').innerHTML = ex.products.map(function (p) {
        return '<div class="p-item"><div class="p-art"><i class="shape-' + p[2] + '"></i></div>' +
               '<div>' + escapeHtml(p[0]) + '</div><div class="p-price">' + escapeHtml(money(p[1], ex)) + '</div></div>';
      }).join('');
      preview.setAttribute('aria-label', 'Example store preview: ' + ex.name + ', ' + ex.tagline);
    }

    function build(ex) {
      timers.forEach(clearTimeout); timers = [];
      if (reduceMotion) { paint(ex); return; }

      steps.forEach(function (s) { s.classList.remove('done'); });
      status.classList.add('is-visible');
      preview.classList.add('is-building');

      timers.push(setTimeout(function () { steps[0].classList.add('done'); }, 250));
      timers.push(setTimeout(function () { steps[1].classList.add('done'); paint(ex); }, 550));
      timers.push(setTimeout(function () { steps[2].classList.add('done'); preview.classList.remove('is-building'); }, 850));
      timers.push(setTimeout(function () { steps[3].classList.add('done'); }, 1150));
      timers.push(setTimeout(function () { status.classList.remove('is-visible'); }, 2300));
    }

    EXAMPLES.forEach(function (ex, i) {
      var li = document.createElement('li');
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'chip';
      btn.textContent = ex.chip;
      btn.setAttribute('aria-pressed', i === 0 ? 'true' : 'false');
      btn.addEventListener('click', function () {
        chipsEl.querySelectorAll('.chip').forEach(function (c) { c.setAttribute('aria-pressed', 'false'); });
        btn.setAttribute('aria-pressed', 'true');
        promptEl.value = ex.prompt;
        build(ex);
      });
      li.appendChild(btn);
      chipsEl.appendChild(li);
    });

    // Pricing: show prices in the visitor's currency (rupees in India), switchable
    (function () {
      var buttons = document.querySelectorAll('.currency [data-currency]');
      if (!buttons.length) return;
      function show(code) {
        document.querySelectorAll('[data-price]').forEach(function (el) { el.hidden = el.getAttribute('data-price') !== code; });
        buttons.forEach(function (b) { b.setAttribute('aria-pressed', b.getAttribute('data-currency') === code ? 'true' : 'false'); });
        try { localStorage.setItem('tellora-currency', code); } catch (e) {}
      }
      var saved = null;
      try { saved = localStorage.getItem('tellora-currency'); } catch (e) {}
      var zone = '';
      try { zone = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}
      var india = zone === 'Asia/Kolkata' || zone === 'Asia/Calcutta';
      var first = buttons[0].getAttribute('data-currency');
      var pick = saved || (india ? 'INR' : 'USD');
      if (!document.querySelector('.currency [data-currency="' + pick + '"]')) pick = first;
      show(pick);
      buttons.forEach(function (b) { b.addEventListener('click', function () { show(b.getAttribute('data-currency')); }); });
    })();

    document.querySelectorAll('[data-start-free]').forEach(function (a) {
      a.addEventListener('click', function () {
        setTimeout(function () { promptEl.focus({ preventScroll: true }); }, reduceMotion ? 0 : 450);
      });
    });

    document.getElementById('closing-cta').addEventListener('click', function () {
      setTimeout(function () { promptEl.focus({ preventScroll: true }); }, reduceMotion ? 0 : 450);
    });

    paint(EXAMPLES[0]);
    // The one page-load moment: build the first example once.
    if (!reduceMotion) { setTimeout(function () { build(EXAMPLES[0]); }, 400); }
  })();
</script>

