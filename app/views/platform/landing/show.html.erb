<% preview_domain = TenantResolver.platform_domains.first || request.host %>
<% content_for :head do %>
<style>
  /* Hero */
  .hero { padding: clamp(2.5rem, 6vw, 5rem) 0 clamp(3rem, 7vw, 6rem); }
  .hero .wrap { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  @media (max-width: 960px) { .hero .wrap { grid-template-columns: 1fr; } }

  .hero h1 { font-size: var(--step-4); font-weight: 800; letter-spacing: -0.035em; max-width: 15ch; }
  .hero-lede { margin-top: 1.25rem; font-size: var(--step-1); color: var(--muted); max-width: 34rem; line-height: 1.5; }

  .build { margin-top: 2rem; }
  .build label { display: block; font-weight: 600; margin-bottom: 0.5rem; }
  .prompt-box {
    border: 2px solid var(--ink);
    border-radius: var(--radius-l);
    background: var(--paper);
    padding: 0.35rem;
    box-shadow: 6px 6px 0 var(--ink);
  }
  .prompt-box:focus-within { box-shadow: 6px 6px 0 var(--marigold); }
  .prompt-box textarea {
    display: block; width: 100%; resize: vertical; min-height: 6.5rem;
    border: 0; outline: none; background: transparent;
    font: 400 var(--step-1)/1.45 var(--font-body); color: var(--ink);
    padding: 0.85rem 0.95rem 0.5rem;
  }
  .prompt-box textarea::placeholder { color: #8d90a8; }
  .prompt-actions { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.4rem 0.4rem 0.4rem 0.95rem; }
  .prompt-hint { font-size: var(--step--1); color: var(--muted); }
  @media (max-width: 520px) {
    .prompt-actions { flex-direction: column; align-items: stretch; padding: 0.4rem; }
    .prompt-hint { padding: 0 0.55rem; }
  }

  .examples { margin-top: 1.25rem; }
  .examples p { font-size: var(--step--1); color: var(--muted); margin-bottom: 0.6rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; margin: 0; padding: 0; }
  .chip {
    font: 500 var(--step--1)/1 var(--font-body);
    padding: 0.55rem 0.85rem; border-radius: 999px;
    border: 1px solid var(--line); background: var(--paper); color: var(--ink); cursor: pointer;
  }
  .chip:hover { border-color: var(--ink); }
  .chip[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: var(--paper); }

  /* Live store preview: the one bold element on the page */
  .preview-frame { position: relative; }
  .preview {
    --p-bg: #f6f3ee; --p-ink: #2b2a28; --p-accent: #3a4a6b; --p-band: #e7e1d8; --p-font: Georgia, serif;
    border-radius: var(--radius-l);
    border: 1px solid var(--line);
    overflow: hidden;
    background: var(--p-bg); color: var(--p-ink);
    box-shadow: 0 30px 60px -30px rgba(24, 22, 58, 0.35);
    transition: background-color 0.45s ease, color 0.45s ease;
  }
  .preview-bar { display: flex; align-items: center; gap: 0.75rem; padding: 0.6rem 0.85rem; background: var(--paper); border-bottom: 1px solid var(--line); }
  .preview-bar .dots { display: flex; gap: 0.35rem; }
  .preview-bar .dots span { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--line); }
  .preview-url { flex: 1; font-size: 0.8rem; color: var(--muted); background: var(--mist); border-radius: 999px; padding: 0.3rem 0.8rem; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

  .p-header { display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.25rem; }
  .p-name { font-family: var(--p-font); font-weight: 700; font-size: 1.15rem; }
  .p-nav { display: flex; gap: 0.9rem; font-size: 0.78rem; opacity: 0.75; }
  .p-band { background: var(--p-band); padding: 1.6rem 1.25rem 1.8rem; transition: background-color 0.45s ease; }
  .p-tagline { font-family: var(--p-font); font-size: clamp(1.3rem, 1rem + 1.4vw, 1.9rem); line-height: 1.15; max-width: 20ch; }
  .p-cta { display: inline-block; margin-top: 0.9rem; font-size: 0.78rem; font-weight: 600; padding: 0.5rem 0.9rem; border-radius: 999px; background: var(--p-accent); color: var(--p-bg); }
  .p-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.75rem; padding: 1.1rem 1.25rem 1.4rem; }
  @media (max-width: 520px) { .p-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .p-item { font-size: 0.75rem; line-height: 1.3; }
  .p-art { aspect-ratio: 1; border-radius: 10px; background: var(--p-band); display: grid; place-items: center; margin-bottom: 0.45rem; transition: background-color 0.45s ease; }
  .p-art i { display: block; width: 46%; height: 46%; background: var(--p-accent); transition: background-color 0.45s ease; }
  .shape-circle { border-radius: 50%; }
  .shape-arch { border-radius: 999px 999px 4px 4px; height: 58% !important; }
  .shape-leaf { border-radius: 0 70% 0 70%; }
  .shape-pill { border-radius: 999px; width: 30% !important; height: 62% !important; }
  .shape-diamond { transform: rotate(45deg); border-radius: 4px; width: 38% !important; height: 38% !important; }
  .p-price { font-weight: 600; margin-top: 0.15rem; }

  .p-item, .p-tagline, .p-name { transition: opacity 0.3s ease, transform 0.3s ease; }
  .preview.is-building .p-item, .preview.is-building .p-tagline, .preview.is-building .p-name { opacity: 0; transform: translateY(6px); }

  .build-status {
    position: absolute; right: 1rem; top: 4.4rem;
    background: var(--paper); color: var(--ink);
    border: 1px solid var(--line); border-radius: 12px;
    padding: 0.7rem 0.9rem; font-size: 0.8rem; min-width: 13.5rem;
    box-shadow: 0 12px 30px -16px rgba(24, 22, 58, 0.45);
    opacity: 0; transform: translateY(8px); transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
  }
  .build-status.is-visible { opacity: 1; transform: none; }
  .build-status ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .build-status li { display: flex; gap: 0.5rem; align-items: center; color: var(--muted); }
  .build-status li::before { content: ''; width: 0.7rem; height: 0.7rem; border-radius: 50%; border: 2px solid var(--line); flex: none; }
  .build-status li.done { color: var(--ink); }
  .build-status li.done::before { background: var(--marigold); border-color: var(--marigold); }
  .preview-caption { margin-top: 0.9rem; font-size: var(--step--1); color: var(--muted); }

  /* Sections */
  .section { padding: clamp(3.5rem, 8vw, 6.5rem) 0; }
  .section-mist { background: var(--mist); }
  .section h2 { font-size: var(--step-3); font-weight: 700; max-width: 22ch; }
  .section-intro { margin-top: 0.9rem; color: var(--muted); font-size: var(--step-1); max-width: 40rem; line-height: 1.5; }

  .steps { list-style: none; margin: 2.75rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.5rem; counter-reset: step; }
  @media (max-width: 860px) { .steps { grid-template-columns: 1fr; gap: 2rem; } }
  .steps li { counter-increment: step; border-top: 2px solid var(--ink); padding-top: 1.1rem; }
  .steps li::before { content: counter(step); font-family: var(--font-display); font-weight: 800; font-size: var(--step-3); line-height: 1; display: block; margin-bottom: 0.9rem; }
  .steps h3 { font-size: var(--step-1); font-weight: 700; margin-bottom: 0.5rem; }
  .steps p { color: var(--muted); max-width: 34ch; }

  .included { margin: 2.75rem 0 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 3.5rem; }
  @media (max-width: 760px) { .included { grid-template-columns: 1fr; } }
  .included div { padding: 1.25rem 0; border-bottom: 1px solid var(--line); }
  .included dt { font-weight: 600; font-size: var(--step-1); }
  .included dd { margin: 0.3rem 0 0; color: var(--muted); max-width: 44ch; }

  .anywhere { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  @media (max-width: 860px) { .anywhere { grid-template-columns: 1fr; } }
  .languages { font-family: var(--font-display); font-weight: 700; font-size: var(--step-2); line-height: 1.35; color: var(--ink); }
  .languages span { display: inline-block; margin-right: 0.9rem; }
  .languages span:nth-child(3n+2) { color: var(--muted); }
  .facts { list-style: none; margin: 1.75rem 0 0; padding: 0; display: grid; gap: 1rem; }
  .facts li { padding-left: 1.1rem; border-left: 3px solid var(--marigold); }
  .facts strong { display: block; }
  .facts span { color: var(--muted); }

  .faq { margin-top: 2.25rem; max-width: 46rem; }
  .faq details { border-bottom: 1px solid var(--line); }
  .faq summary { cursor: pointer; list-style: none; padding: 1.15rem 2rem 1.15rem 0; font-weight: 600; font-size: var(--step-1); position: relative; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; position: absolute; right: 0.25rem; top: 1rem; font-family: var(--font-display); font-size: 1.6rem; line-height: 1; transition: transform 0.2s ease; }
  .faq details[open] summary::after { transform: rotate(45deg); }
  .faq details p { padding: 0 0 1.25rem; color: var(--muted); max-width: 60ch; }

  .closing { text-align: center; }
  .closing h2 { margin: 0 auto; }
  .closing .section-intro { margin-left: auto; margin-right: auto; }
  .closing .button { margin-top: 2rem; }
</style>
<% end %>

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap">
    <div>
      <h1 id="hero-title">Tell us what you sell. Get a store ready to sell it.</h1>
      <p class="hero-lede">Write one sentence about your business, in your own language. AI designs the store, writes your first products and sets up checkout.</p>

      <div class="build" id="build">
        <% if flash[:alert] %><p class="flash" role="alert"><%= flash[:alert] %></p><% end %>

        <%= form_with url: platform_start_path, method: :post, id: 'build-form', data: { turbo: false } do %>
          <label for="prompt">What does your business sell?</label>
          <div class="prompt-box">
            <textarea id="prompt" name="prompt" maxlength="500" required
                      placeholder="Handmade leather bags from Florence, for people who travel light"><%= @prompt %></textarea>
            <div class="prompt-actions">
              <span class="prompt-hint">Any language. Change anything later by chatting.</span>
              <button type="submit" class="button">Build my store</button>
            </div>
          </div>
        <% end %>

        <div class="examples">
          <p id="examples-label">Or start from an example and watch the preview change:</p>
          <ul class="chips" aria-labelledby="examples-label" id="chips"></ul>
        </div>
      </div>
    </div>

    <div class="preview-frame">
      <div class="preview" id="preview" role="img" aria-label="Example store preview">
        <div class="preview-bar" aria-hidden="true">
          <div class="dots"><span></span><span></span><span></span></div>
          <div class="preview-url" id="p-url"></div>
        </div>
        <div class="p-header">
          <span class="p-name" id="p-name"></span>
          <span class="p-nav" aria-hidden="true"><span>Shop</span><span>About</span><span>Cart</span></span>
        </div>
        <div class="p-band">
          <p class="p-tagline" id="p-tagline"></p>
          <span class="p-cta" id="p-cta">Shop now</span>
        </div>
        <div class="p-grid" id="p-grid"></div>
      </div>

      <div class="build-status" id="build-status" aria-live="polite">
        <ol>
          <li>Reading your description</li>
          <li>Choosing colours and type</li>
          <li>Writing products and prices</li>
          <li>Store ready</li>
        </ol>
      </div>
      <p class="preview-caption">Example preview. Your real store is designed from your own description.</p>
    </div>
  </div>
</section>

<section class="section section-mist" id="how" aria-labelledby="how-title">
  <div class="wrap">
    <h2 id="how-title">From one sentence to a working shop</h2>
    <p class="section-intro">No templates to pick and no settings to learn. You describe the business; the store is built around it.</p>
    <ol class="steps">
      <li>
        <h3>Describe</h3>
        <p>Say what you sell and who buys it, in any language. If you already have a brand brief, upload it instead.</p>
      </li>
      <li>
        <h3>Review</h3>
        <p>See your store with its colours, fonts and starter products. Ask for changes in plain words, like "warmer colours" or "bigger photos".</p>
      </li>
      <li>
        <h3>Start selling</h3>
        <p>Add your own products, connect payments and your domain, then share your link with customers.</p>
      </li>
    </ol>
  </div>
</section>

<section class="section" id="included" aria-labelledby="included-title">
  <div class="wrap">
    <h2 id="included-title">Everything a store needs, from the first minute</h2>
    <dl class="included">
      <div><dt>A design made for your business</dt><dd>Colours, fonts and layout chosen for what you sell and who you sell to, not picked from a template list.</dd></div>
      <div><dt>Starter products</dt><dd>Names, descriptions, prices and photos to show how your store will look. They are marked as samples, so you can replace them anytime.</dd></div>
      <div><dt>Checkout and payments</dt><dd>Card and wallet payments through Stripe, PayPal, Razorpay, Cashfree or CCAvenue, depending on your country.</dd></div>
      <div><dt>Your own web address</dt><dd>Every store gets its own address straight away. Connect a domain you already own whenever you are ready.</dd></div>
      <div><dt>Orders, stock and customers</dt><dd>One dashboard for orders, inventory, customers, invoices and packing slips.</dd></div>
      <div><dt>Changes by chat</dt><dd>Ask the AI to adjust the design, rewrite a description or add a sale banner. No code involved.</dd></div>
      <div><dt>Shipping</dt><dd>Shipping rates and zones built in, with Shiprocket for sellers in India.</dd></div>
      <div><dt>Marketing</dt><dd>Connect Google Analytics to see your traffic and Klaviyo to send email campaigns.</dd></div>
    </dl>
  </div>
</section>

<section class="section section-mist" aria-labelledby="anywhere-title">
  <div class="wrap anywhere">
    <div>
      <h2 id="anywhere-title">Built for selling wherever you are</h2>
      <p class="section-intro">Describe your business the way you would to a friend, in the language you think in.</p>
      <ul class="facts">
        <li><strong>Your language</strong><span>Write your description in any language; the AI understands it.</span></li>
        <li><strong>Your customers</strong><span>Each store has its own currency, address and checkout settings.</span></li>
        <li><strong>Your data</strong><span>Every store is kept in its own separate space, apart from every other store.</span></li>
      </ul>
    </div>
    <p class="languages" aria-label="Examples of languages you can write in">
      <span lang="en">Handmade</span><span lang="es">Hecho a mano</span><span lang="fr">Fait main</span>
      <span lang="hi">हस्तनिर्मित</span><span lang="ja">手作り</span><span lang="ar" dir="rtl">مصنوع يدويًا</span>
      <span lang="pt">Feito à mão</span><span lang="de">Handgemacht</span><span lang="sw">Imetengenezwa kwa mkono</span>
      <span lang="id">Buatan tangan</span><span lang="tr">El yapımı</span><span lang="ko">수제</span>
    </p>
  </div>
</section>

<section class="section" id="questions" aria-labelledby="questions-title">
  <div class="wrap">
    <h2 id="questions-title">Questions</h2>
    <div class="faq">
      <details>
        <summary>Do I need design or coding skills?</summary>
        <p>No. You describe your business in your own words and the store is built for you. Later changes work the same way: you ask, and the AI makes them.</p>
      </details>
      <details>
        <summary>Which languages can I use?</summary>
        <p>Any language you can write in. Describe your store in the language that comes naturally; the AI understands it.</p>
      </details>
      <details>
        <summary>Can I change the design after the store is built?</summary>
        <p>Yes. Open the AI designer, say what you want changed, preview the result and apply it when you are happy. You can also go back to the standard design at any time.</p>
      </details>
      <details>
        <summary>What happens to the sample products?</summary>
        <p>They are there to show how your store will look. Each one is marked as a sample, so you can delete them all once you add your own products.</p>
      </details>
      <details>
        <summary>Can I use my own domain?</summary>
        <p>Yes. Your store starts on its own address, and you can connect a domain you already own whenever you are ready.</p>
      </details>
      <details>
        <summary>Who owns my store's data?</summary>
        <p>You do. Each store's products, orders and customers are kept in their own separate space, apart from every other store on the platform.</p>
      </details>
    </div>
  </div>
</section>

<section class="section section-mist closing" aria-labelledby="closing-title">
  <div class="wrap">
    <h2 id="closing-title">Your store is one sentence away</h2>
    <p class="section-intro">Describe what you sell. You can change everything afterwards.</p>
    <a class="button" href="#build" id="closing-cta">Describe my business</a>
  </div>
</section>

<script>
  (function () {
    var DOMAIN = <%= raw preview_domain.to_json %>;

    // Example stores from around the world. Prompts are written in local languages on purpose.
    var EXAMPLES = [
      { chip: 'Ceramics, Kyoto', prompt: '京都の手作り陶器スタジオ。茶碗、花瓶、酒器を販売しています。', name: 'Kiln & Clay', slug: 'kiln-and-clay',
        tagline: 'Slow-made ceramics for everyday tea', locale: 'ja-JP', currency: 'JPY',
        colors: { bg: '#f4f1ec', ink: '#2a2826', accent: '#3d4f6e', band: '#e3ddd3' }, font: "Georgia, 'Times New Roman', serif",
        products: [['Tea bowl, ash glaze', 6800, 'circle'], ['Bud vase', 9200, 'pill'], ['Sake cup pair', 5400, 'arch'], ['Incense stand', 2600, 'diamond']] },
      { chip: 'Spices, Kerala', prompt: 'Organic spice farm in Kerala selling cardamom, black pepper and turmeric directly to home cooks', name: 'Malabar Harvest', slug: 'malabar-harvest',
        tagline: 'Spices picked on our farm, packed the same week', locale: 'en-IN', currency: 'INR',
        colors: { bg: '#fbf7ec', ink: '#24301e', accent: '#2f6b3a', band: '#f0ddb0' }, font: "'Trebuchet MS', 'Segoe UI', sans-serif",
        products: [['Green cardamom', 449, 'leaf'], ['Tellicherry pepper', 329, 'circle'], ['Wild turmeric', 249, 'arch'], ['Spice gift box', 1299, 'diamond']] },
      { chip: 'Streetwear, Lagos', prompt: 'Bold streetwear brand from Lagos: graphic tees, hoodies and caps for young people', name: 'Eko Thread', slug: 'eko-thread',
        tagline: 'Made in Lagos. Worn everywhere.', locale: 'en-NG', currency: 'NGN',
        colors: { bg: '#121212', ink: '#f5f5f0', accent: '#ff5a1f', band: '#262626' }, font: "Impact, 'Arial Narrow', sans-serif",
        products: [['Graphic tee', 18500, 'diamond'], ['Heavy hoodie', 42000, 'arch'], ['Five-panel cap', 12000, 'circle'], ['Tote bag', 9500, 'pill']] },
      { chip: 'Cheese, Lyon', prompt: 'Fromagerie artisanale à Lyon : fromages affinés, plateaux et coffrets cadeaux', name: 'Fromagerie Lumière', slug: 'fromagerie-lumiere',
        tagline: 'Fromages affinés à Lyon depuis trois générations', locale: 'fr-FR', currency: 'EUR',
        colors: { bg: '#fffdf6', ink: '#3b2f1e', accent: '#8a1c2b', band: '#f3e7c4' }, font: "'Palatino Linotype', Palatino, Georgia, serif",
        products: [['Comté 24 mois', 12.9, 'diamond'], ['Saint-Marcellin', 6.5, 'circle'], ['Plateau découverte', 34, 'arch'], ['Coffret cadeau', 49, 'pill']] },
      { chip: 'Coffee, Bogotá', prompt: 'Tostadora de café de especialidad en Bogotá, cafés de origen único y suscripciones mensuales', name: 'Cerro Tostado', slug: 'cerro-tostado',
        tagline: 'Café de origen, tostado esta semana', locale: 'es-CO', currency: 'COP',
        colors: { bg: '#f7f0e8', ink: '#2e1d14', accent: '#b4532a', band: '#e9d3bf' }, font: "'Gill Sans', 'Segoe UI', sans-serif",
        products: [['Huila 340 g', 42000, 'leaf'], ['Nariño 340 g', 46000, 'circle'], ['Suscripción mensual', 120000, 'arch'], ['Prensa francesa', 98000, 'pill']] },
      { chip: 'Surf, Sydney', prompt: 'Surf shop on Sydney\'s northern beaches selling boards, wetsuits and lessons', name: 'Saltline Surf', slug: 'saltline-surf',
        tagline: 'Boards and wetsuits for the northern beaches', locale: 'en-AU', currency: 'AUD',
        colors: { bg: '#eef7f8', ink: '#0f2e3a', accent: '#0a7ea4', band: '#cfe9ee' }, font: "Verdana, 'Segoe UI', sans-serif",
        products: [['Soft-top 7 ft', 449, 'pill'], ['3/2 wetsuit', 329, 'arch'], ['Wax pack', 12, 'circle'], ['Group lesson', 75, 'leaf']] }
    ];

    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var preview = document.getElementById('preview');
    var status = document.getElementById('build-status');
    var steps = status.querySelectorAll('li');
    var chipsEl = document.getElementById('chips');
    var promptEl = document.getElementById('prompt');
    var timers = [];

    function money(value, ex) {
      try { return new Intl.NumberFormat(ex.locale, { style: 'currency', currency: ex.currency, maximumFractionDigits: value % 1 ? 2 : 0 }).format(value); }
      catch (e) { return ex.currency + ' ' + value; }
    }

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; });
    }

    function paint(ex) {
      preview.style.setProperty('--p-bg', ex.colors.bg);
      preview.style.setProperty('--p-ink', ex.colors.ink);
      preview.style.setProperty('--p-accent', ex.colors.accent);
      preview.style.setProperty('--p-band', ex.colors.band);
      preview.style.setProperty('--p-font', ex.font);
      document.getElementById('p-url').textContent = 'https://' + ex.slug + '.' + DOMAIN;
      document.getElementById('p-name').textContent = ex.name;
      var tagline = document.getElementById('p-tagline');
      tagline.textContent = ex.tagline;
      tagline.lang = ex.locale.split('-')[0];
      document.getElementById('p-grid').innerHTML = ex.products.map(function (p) {
        return '<div class="p-item"><div class="p-art"><i class="shape-' + p[2] + '"></i></div>' +
               '<div>' + escapeHtml(p[0]) + '</div><div class="p-price">' + escapeHtml(money(p[1], ex)) + '</div></div>';
      }).join('');
      preview.setAttribute('aria-label', 'Example store preview: ' + ex.name + ', ' + ex.tagline);
    }

    function build(ex) {
      timers.forEach(clearTimeout); timers = [];
      if (reduceMotion) { paint(ex); return; }

      steps.forEach(function (s) { s.classList.remove('done'); });
      status.classList.add('is-visible');
      preview.classList.add('is-building');

      timers.push(setTimeout(function () { steps[0].classList.add('done'); }, 250));
      timers.push(setTimeout(function () { steps[1].classList.add('done'); paint(ex); }, 550));
      timers.push(setTimeout(function () { steps[2].classList.add('done'); preview.classList.remove('is-building'); }, 850));
      timers.push(setTimeout(function () { steps[3].classList.add('done'); }, 1150));
      timers.push(setTimeout(function () { status.classList.remove('is-visible'); }, 2300));
    }

    EXAMPLES.forEach(function (ex, i) {
      var li = document.createElement('li');
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'chip';
      btn.textContent = ex.chip;
      btn.setAttribute('aria-pressed', i === 0 ? 'true' : 'false');
      btn.addEventListener('click', function () {
        chipsEl.querySelectorAll('.chip').forEach(function (c) { c.setAttribute('aria-pressed', 'false'); });
        btn.setAttribute('aria-pressed', 'true');
        promptEl.value = ex.prompt;
        build(ex);
      });
      li.appendChild(btn);
      chipsEl.appendChild(li);
    });

    document.getElementById('closing-cta').addEventListener('click', function () {
      setTimeout(function () { promptEl.focus({ preventScroll: true }); }, reduceMotion ? 0 : 450);
    });

    paint(EXAMPLES[0]);
    // The one page-load moment: build the first example once.
    if (!reduceMotion) { setTimeout(function () { build(EXAMPLES[0]); }, 400); }
  })();
</script>

