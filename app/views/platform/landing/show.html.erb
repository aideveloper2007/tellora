<% preview_domain = TenantResolver.platform_domains.first || request.host %>
<% content_for :head do %>
<style>
  /* Hero */
  .hero { padding: clamp(2.5rem, 6vw, 5rem) 0 clamp(3rem, 7vw, 6rem); }
  .hero .wrap { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  @media (max-width: 960px) { .hero .wrap { grid-template-columns: 1fr; } }

  .hero h1 { font-size: var(--step-4); font-weight: 800; letter-spacing: -0.035em; max-width: 15ch; }
  .hero-lede { margin-top: 1.25rem; font-size: var(--step-1); color: var(--muted); max-width: 34rem; line-height: 1.5; }

  .build { margin-top: 2rem; }
  .build label { display: block; font-weight: 600; margin-bottom: 0.5rem; }
  .prompt-box {
    border: 2px solid var(--ink);
    border-radius: var(--radius-l);
    background: var(--paper);
    padding: 0.35rem;
    box-shadow: 6px 6px 0 var(--ink);
  }
  .prompt-box:focus-within { box-shadow: 6px 6px 0 var(--marigold); }
  .prompt-box textarea {
    display: block; width: 100%; resize: vertical; min-height: 6.5rem;
    border: 0; outline: none; background: transparent;
    font: 400 var(--step-1)/1.45 var(--font-body); color: var(--ink);
    padding: 0.85rem 0.95rem 0.5rem;
  }
  .prompt-box textarea::placeholder { color: #8d90a8; }
  .prompt-actions { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.4rem 0.4rem 0.4rem 0.95rem; }
  .prompt-hint { font-size: var(--step--1); color: var(--muted); }
  @media (max-width: 520px) {
    .prompt-actions { flex-direction: column; align-items: stretch; padding: 0.4rem; }
    .prompt-hint { padding: 0 0.55rem; }
  }

  .examples { margin-top: 1.25rem; }
  .examples p { font-size: var(--step--1); color: var(--muted); margin-bottom: 0.6rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; list-style: none; margin: 0; padding: 0; }
  .chip {
    font: 500 var(--step--1)/1 var(--font-body);
    padding: 0.55rem 0.85rem; border-radius: 999px;
    border: 1px solid var(--line); background: var(--paper); color: var(--ink); cursor: pointer;
  }
  .chip:hover { border-color: var(--ink); }
  .chip[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: var(--paper); }

  /* Live store preview: the one bold element on the page */
  .preview-frame { position: relative; }
  .preview {
    --p-bg: #f6f3ee; --p-ink: #2b2a28; --p-accent: #3a4a6b; --p-band: #e7e1d8; --p-font: Georgia, serif;
    border-radius: var(--radius-l);
    border: 1px solid var(--line);
    overflow: hidden;
    background: var(--p-bg); color: var(--p-ink);
    box-shadow: 0 30px 60px -30px rgba(24, 22, 58, 0.35);
    transition: background-color 0.45s ease, color 0.45s ease;
  }
  .preview-bar { display: flex; align-items: center; gap: 0.75rem; padding: 0.6rem 0.85rem; background: var(--paper); border-bottom: 1px solid var(--line); }
  .preview-bar .dots { display: flex; gap: 0.35rem; }
  .preview-bar .dots span { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: var(--line); }
  .preview-url { flex: 1; font-size: 0.8rem; color: var(--muted); background: var(--mist); border-radius: 999px; padding: 0.3rem 0.8rem; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

  .p-header { display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.25rem; }
  .p-name { font-family: var(--p-font); font-weight: 700; font-size: 1.15rem; }
  .p-nav { display: flex; gap: 0.9rem; font-size: 0.78rem; opacity: 0.75; }
  .p-band { background: var(--p-band); padding: 1.6rem 1.25rem 1.8rem; transition: background-color 0.45s ease; }
  .p-tagline { font-family: var(--p-font); font-size: clamp(1.3rem, 1rem + 1.4vw, 1.9rem); line-height: 1.15; max-width: 20ch; }
  .p-cta { display: inline-block; margin-top: 0.9rem; font-size: 0.78rem; font-weight: 600; padding: 0.5rem 0.9rem; border-radius: 999px; background: var(--p-accent); color: var(--p-bg); }
  .p-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.75rem; padding: 1.1rem 1.25rem 1.4rem; }
  @media (max-width: 520px) { .p-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .p-item { font-size: 0.75rem; line-height: 1.3; }
  .p-art { aspect-ratio: 1; border-radius: 10px; background: var(--p-band); display: grid; place-items: center; margin-bottom: 0.45rem; transition: background-color 0.45s ease; }
  .p-art i { display: block; width: 46%; height: 46%; background: var(--p-accent); transition: background-color 0.45s ease; }
  .shape-circle { border-radius: 50%; }
  .shape-arch { border-radius: 999px 999px 4px 4px; height: 58% !important; }
  .shape-leaf { border-radius: 0 70% 0 70%; }
  .shape-pill { border-radius: 999px; width: 30% !important; height: 62% !important; }
  .shape-diamond { transform: rotate(45deg); border-radius: 4px; width: 38% !important; height: 38% !important; }
  .p-price { font-weight: 600; margin-top: 0.15rem; }

  .p-item, .p-tagline, .p-name { transition: opacity 0.3s ease, transform 0.3s ease; }
  .preview.is-building .p-item, .preview.is-building .p-tagline, .preview.is-building .p-name { opacity: 0; transform: translateY(6px); }

  .build-status {
    position: absolute; right: 1rem; top: 4.4rem;
    background: var(--paper); color: var(--ink);
    border: 1px solid var(--line); border-radius: 12px;
    padding: 0.7rem 0.9rem; font-size: 0.8rem; min-width: 13.5rem;
    box-shadow: 0 12px 30px -16px rgba(24, 22, 58, 0.45);
    opacity: 0; transform: translateY(8px); transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
  }
  .build-status.is-visible { opacity: 1; transform: none; }
  .build-status ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .build-status li { display: flex; gap: 0.5rem; align-items: center; color: var(--muted); }
  .build-status li::before { content: ''; width: 0.7rem; height: 0.7rem; border-radius: 50%; border: 2px solid var(--line); flex: none; }
  .build-status li.done { color: var(--ink); }
  .build-status li.done::before { background: var(--marigold); border-color: var(--marigold); }
  .preview-caption { margin-top: 0.9rem; font-size: var(--step--1); color: var(--muted); }

  /* Sections */
  .section { padding: clamp(3.5rem, 8vw, 6.5rem) 0; }
  .section-mist { background: var(--mist); }
  .section h2 { font-size: var(--step-3); font-weight: 700; max-width: 22ch; }
  .section-intro { margin-top: 0.9rem; color: var(--muted); font-size: var(--step-1); max-width: 40rem; line-height: 1.5; }

  /* Journey: from one sentence to the customer's door */
  .journey-phase { margin: 2.75rem 0 1rem; display: flex; align-items: center; gap: 0.75rem; font-weight: 700; font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  .journey-phase::after { content: ''; flex: 1; height: 1px; background: var(--line); }
  .journey { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; counter-reset: stage; }
  .journey-sell { counter-reset: stage 4; }
  @media (max-width: 1080px) { .journey { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .journey { grid-template-columns: 1fr; } }
  .stage { counter-increment: stage; display: flex; flex-direction: column; background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-l); overflow: hidden; }
  .stage-art { position: relative; height: 8.5rem; background: var(--mist); border-bottom: 1px solid var(--line); display: grid; place-items: center; padding: 1rem; overflow: hidden; }
  .stage-body { padding: 1.15rem 1.25rem 1.35rem; }
  .stage h3 { display: flex; align-items: baseline; gap: 0.6rem; font-size: var(--step-1); font-weight: 700; line-height: 1.2; }
  .stage h3::before { content: counter(stage); flex: none; display: inline-grid; place-items: center; width: 1.75rem; height: 1.75rem; border-radius: 50%; background: var(--ink); color: var(--paper); font-size: 0.9rem; font-weight: 800; transform: translateY(-0.1rem); }
  .stage p { margin-top: 0.55rem !important; color: var(--muted); font-size: 0.97rem; line-height: 1.55; }

  /* Small drawn scenes (decorative) */
  .art-prompt { width: 100%; max-width: 15rem; background: var(--paper); border: 2px solid var(--ink); border-radius: 12px; padding: 0.65rem 0.75rem; font-size: 0.85rem; line-height: 1.35; box-shadow: 4px 4px 0 var(--ink); }
  .art-prompt b { display: inline-block; width: 2px; height: 1em; background: var(--ink); vertical-align: -0.15em; margin-left: 2px; animation: caret 1s steps(1) infinite; }
  @keyframes caret { 50% { opacity: 0; } }
  .art-styles { display: flex; gap: 0.5rem; }
  .art-styles span { width: 4.1rem; height: 5.2rem; border-radius: 8px; display: flex; flex-direction: column; justify-content: space-between; padding: 0.45rem; font-family: Georgia, 'Times New Roman', serif; font-size: 1.35rem; line-height: 1; box-shadow: 0 6px 16px -10px rgba(24, 22, 58, 0.5); }
  .art-styles span:nth-child(2) { transform: translateY(-0.4rem); }
  .art-styles i { display: block; width: 100%; height: 0.4rem; border-radius: 99px; }
  .art-products { display: grid; grid-template-columns: repeat(3, 4rem); gap: 0.5rem; }
  .art-products span { background: var(--paper); border-radius: 8px; padding: 0.35rem; font-size: 0.68rem; font-weight: 600; box-shadow: 0 6px 16px -10px rgba(24, 22, 58, 0.5); }
  .art-products i { display: block; aspect-ratio: 1; border-radius: 5px; margin-bottom: 0.3rem; }
  .art-builder { position: relative; width: 100%; max-width: 15rem; height: 6.5rem; background: var(--paper); border: 1px solid var(--line); border-radius: 10px; display: grid; grid-template-columns: 38% 1fr; overflow: hidden; }
  .art-builder .chat { border-right: 1px solid var(--line); padding: 0.4rem; display: flex; flex-direction: column; justify-content: flex-end; gap: 0.3rem; }
  .art-builder .chat span { font-size: 0.6rem; line-height: 1.25; padding: 0.25rem 0.35rem; border-radius: 6px; background: var(--ink); color: var(--paper); align-self: flex-end; }
  .art-builder .chat span:first-child { background: var(--mist); color: var(--ink); align-self: flex-start; }
  .art-builder .site { padding: 0.4rem; display: grid; gap: 0.3rem; align-content: start; background: #efe6da; }
  .art-builder .site i { display: block; height: 0.45rem; border-radius: 99px; background: #1f1510; opacity: 0.85; }
  .art-builder .site i:nth-child(2) { width: 60%; opacity: 0.4; }
  .art-builder .site b { display: block; height: 2.2rem; border-radius: 4px; background: #8e2a22; opacity: 0.85; }
  .art-url { width: 100%; max-width: 15rem; background: var(--paper); border: 1px solid var(--line); border-radius: 999px; padding: 0.55rem 0.8rem; display: flex; align-items: center; gap: 0.45rem; font-size: 0.8rem; box-shadow: 0 8px 20px -14px rgba(24, 22, 58, 0.6); }
  .art-url svg { flex: none; }
  .art-url em { font-style: normal; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .art-live { position: absolute; top: 1.1rem; right: 1.1rem; background: #e3f4ea; color: #1f7a4d; font-size: 0.72rem; font-weight: 700; padding: 0.25rem 0.6rem; border-radius: 999px; }
  .art-pay { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.4rem; max-width: 15rem; }
  .art-pay span { background: var(--paper); border: 1px solid var(--line); border-radius: 999px; padding: 0.35rem 0.7rem; font-size: 0.78rem; font-weight: 600; }
  .art-pay span:first-child { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .art-order { width: 100%; max-width: 15rem; display: grid; gap: 0.4rem; }
  .art-order .row { display: flex; align-items: center; justify-content: space-between; background: var(--paper); border: 1px solid var(--line); border-radius: 8px; padding: 0.4rem 0.6rem; font-size: 0.75rem; font-weight: 600; }
  .art-order .track { display: flex; align-items: center; gap: 0.3rem; font-size: 0.68rem; color: var(--muted); }
  .art-order .track span { flex: 1; text-align: center; padding: 0.2rem 0; border-radius: 99px; background: var(--paper); border: 1px solid var(--line); }
  .art-order .track span.on { background: var(--marigold); border-color: var(--marigold); color: var(--ink); font-weight: 700; }
  .art-grow { width: 100%; max-width: 15rem; display: grid; grid-template-columns: 1fr auto; gap: 0.6rem; align-items: end; }
  .art-grow .serp { background: var(--paper); border: 1px solid var(--line); border-radius: 8px; padding: 0.45rem 0.55rem; font-size: 0.62rem; line-height: 1.35; }
  .art-grow .serp b { display: block; color: #1a0dab; font-size: 0.72rem; }
  .art-grow .serp em { font-style: normal; color: #1f7a4d; }
  .art-grow .bars { display: flex; align-items: flex-end; gap: 0.25rem; height: 4.5rem; }
  .art-grow .bars i { display: block; width: 0.55rem; border-radius: 3px 3px 0 0; background: var(--ink); }
  .art-grow .bars i:last-child { background: var(--marigold); }

  .journey-end { margin-top: 1.5rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem 2rem; flex-wrap: wrap; background: var(--ink); color: var(--paper); border-radius: var(--radius-l); padding: 1.35rem 1.6rem; }
  .journey-end p { font-family: var(--font-display); font-weight: 700; font-size: var(--step-1); }
  .journey-end .button { background: var(--marigold); border-color: var(--marigold); color: var(--ink); }
  .journey-end .button:hover { background: #ffc629; border-color: #ffc629; }

  .included { margin: 2.75rem 0 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 3.5rem; }
  @media (max-width: 760px) { .included { grid-template-columns: 1fr; } }
  .included div { padding: 1.25rem 0; border-bottom: 1px solid var(--line); }
  .included dt { font-weight: 600; font-size: var(--step-1); }
  .included dd { margin: 0.3rem 0 0; color: var(--muted); max-width: 44ch; }

  .anywhere { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  @media (max-width: 860px) { .anywhere { grid-template-columns: 1fr; } }
  .languages { font-family: var(--font-display); font-weight: 700; font-size: var(--step-2); line-height: 1.35; color: var(--ink); }
  .languages span { display: inline-block; margin-right: 0.9rem; }
  .languages span:nth-child(3n+2) { color: var(--muted); }
  .facts { list-style: none; margin: 1.75rem 0 0; padding: 0; display: grid; gap: 1rem; }
  .facts li { padding-left: 1.1rem; border-left: 3px solid var(--marigold); }
  .facts strong { display: block; }
  .facts span { color: var(--muted); }

  .faq { margin-top: 2.25rem; max-width: 46rem; }
  .faq details { border-bottom: 1px solid var(--line); }
  .faq summary { cursor: pointer; list-style: none; padding: 1.15rem 2rem 1.15rem 0; font-weight: 600; font-size: var(--step-1); position: relative; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; position: absolute; right: 0.25rem; top: 1rem; font-family: var(--font-display); font-size: 1.6rem; line-height: 1; transition: transform 0.2s ease; }
  .faq details[open] summary::after { transform: rotate(45deg); }
  .faq details p { padding: 0 0 1.25rem; color: var(--muted); max-width: 60ch; }

  /* Pricing */
  .offer { margin-top: 1.75rem; display: inline-flex; flex-wrap: wrap; gap: 0.4rem 1.25rem; align-items: center; background: var(--marigold); color: var(--ink); border-radius: 999px; padding: 0.6rem 1.2rem; font-weight: 600; }
  .offer span { display: inline-flex; align-items: center; gap: 0.45rem; }
  .offer span + span::before { content: ''; width: 0.35rem; height: 0.35rem; border-radius: 50%; background: var(--ink); opacity: 0.45; margin-right: 0.8rem; }
  @media (max-width: 600px) { .offer { display: grid; gap: 0.3rem; border-radius: var(--radius-l); padding: 0.8rem 1.1rem; } .offer span + span::before { display: none; } }
  .pricing-bar { margin-top: 2.25rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .pricing-note { color: var(--muted); font-size: var(--step--1); }
  .currency { display: inline-flex; border: 1px solid var(--line); border-radius: 999px; background: var(--paper); padding: 0.2rem; }
  .currency button { font: 600 var(--step--1)/1 var(--font-body); border: 0; background: transparent; color: var(--muted); padding: 0.5rem 0.9rem; border-radius: 999px; cursor: pointer; }
  .currency button[aria-pressed="true"] { background: var(--ink); color: var(--paper); }

  .plans { margin-top: 1.25rem; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; align-items: stretch; }
  @media (max-width: 1080px) { .plans { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .plans { grid-template-columns: 1fr; } }
  .plan { position: relative; display: flex; flex-direction: column; background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-l); padding: 1.5rem 1.35rem 1.35rem; }
  .plan-popular { border: 2px solid var(--ink); box-shadow: 6px 6px 0 var(--ink); }
  .plan-badge { position: absolute; top: -0.8rem; left: 1.2rem; background: var(--marigold); color: var(--ink); font-size: 0.78rem; font-weight: 700; padding: 0.25rem 0.65rem; border-radius: 999px; }
  .plan h3 { font-size: var(--step-2); font-weight: 800; }
  .plan-for { color: var(--muted); font-size: var(--step--1); margin-top: 0.25rem !important; min-height: 3.2em; }
  @media (max-width: 600px) { .plan-for { min-height: 0; } }
  .plan-trial { margin-top: 1.1rem !important; font-weight: 700; }
  .plan-price { margin-top: 0.35rem !important; font-family: var(--font-display); font-weight: 800; font-size: var(--step-3); line-height: 1; letter-spacing: -0.02em; }
  .plan-price small { font-family: var(--font-body); font-size: var(--step--1); font-weight: 500; color: var(--muted); letter-spacing: 0; }
  .plan-monthly { color: var(--muted); font-size: var(--step--1); margin-top: 0.35rem !important; }
  .plan-contact { margin-top: 0.35rem !important; font-family: var(--font-display); font-weight: 800; font-size: var(--step-2); line-height: 1.1; }
  .plan ul { list-style: none; margin: 1.25rem 0 1.5rem; padding: 1.1rem 0 0; border-top: 1px solid var(--line); display: grid; gap: 0.55rem; flex: 1; }
  .plan li { display: flex; gap: 0.55rem; align-items: flex-start; font-size: 0.95rem; line-height: 1.4; }
  .plan li::before { content: ''; flex: none; width: 0.95rem; height: 0.55rem; margin-top: 0.3rem; border-left: 2.5px solid var(--ink); border-bottom: 2.5px solid var(--ink); transform: rotate(-45deg) translateY(-2px); }
  .plan .button { width: 100%; }
  .plan:not(.plan-popular) .button { background: transparent; color: var(--ink); }
  .plan:not(.plan-popular) .button:hover { background: var(--mist); }

  .compare-wrap { margin-top: 3rem; overflow-x: auto; -webkit-overflow-scrolling: touch; background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-l); }
  .compare { width: 100%; min-width: 46rem; border-collapse: collapse; font-size: 0.95rem; }
  .compare caption { text-align: left; padding: 1.1rem 1.25rem 0.4rem; font-family: var(--font-display); font-weight: 700; font-size: var(--step-1); }
  .compare th, .compare td { padding: 0.8rem 1.25rem; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
  .compare thead th { font-family: var(--font-display); font-size: var(--step-0); }
  .compare tbody th { font-weight: 500; color: var(--muted); }
  .compare tbody tr:last-child th, .compare tbody tr:last-child td { border-bottom: 0; }
  .compare .yes { display: inline-block; width: 1rem; height: 0.55rem; border-left: 2.5px solid var(--ink); border-bottom: 2.5px solid var(--ink); transform: rotate(-45deg); }

  .free-all { margin-top: 3.5rem; }
  .free-all h3 { font-size: var(--step-2); font-weight: 800; }
  .free-all > p { margin-top: 0.5rem !important; color: var(--muted); }
  .free-grid { margin-top: 1.75rem; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  @media (max-width: 960px) { .free-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .free-grid { grid-template-columns: 1fr; } }
  .free-grid section { background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-l); padding: 1.25rem 1.35rem; }
  .free-grid h4 { margin: 0 0 0.7rem; font-family: var(--font-display); font-size: var(--step-1); }
  .free-grid ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.45rem; }
  .free-grid li { position: relative; padding-left: 1.1rem; color: var(--muted); font-size: 0.95rem; line-height: 1.45; }
  .free-grid li::before { content: ''; position: absolute; left: 0; top: 0.55rem; width: 0.45rem; height: 0.45rem; border-radius: 50%; background: var(--marigold); }

  .closing { text-align: center; }
  .closing h2 { margin: 0 auto; }
  .closing .section-intro { margin-left: auto; margin-right: auto; }
  .closing .button { margin-top: 2rem; }
</style>
<% end %>

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap">
    <div>
      <h1 id="hero-title">Tell us what you sell. Get a store ready to sell it.</h1>
      <p class="hero-lede">Write one sentence about your business, in your own language. AI designs the store, writes your first products and sets up checkout.</p>

      <div class="build" id="build">
        <% if flash[:alert] %><p class="flash" role="alert"><%= flash[:alert] %></p><% end %>

        <%= form_with url: platform_start_path, method: :post, id: 'build-form', data: { turbo: false } do %>
          <label for="prompt">What does your business sell?</label>
          <div class="prompt-box">
            <textarea id="prompt" name="prompt" maxlength="500" required
                      placeholder="Handmade leather bags from Florence, for people who travel light"><%= @prompt %></textarea>
