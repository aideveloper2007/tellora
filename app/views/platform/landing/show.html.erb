<% plans = TelloraPlans.plans %>
<% currency_keys = TelloraPlans.currencies.keys %>
<section class="section section-mist" id="pricing" aria-labelledby="pricing-title">
  <div class="wrap">
    <h2 id="pricing-title"><%= TelloraPlans.trial_months %> months free. Every feature.</h2>
    <p class="section-intro">Build your store and sell for <%= TelloraPlans.trial_months %> months without paying anything, with every feature switched on. After that, choose the plan that fits and pay every <%= TelloraPlans.billing_months %> months.</p>
    <p class="offer"><span><%= TelloraPlans.trial_months %> months free</span><span>No card needed</span><span>0% fees on your sales</span></p>

    <div class="pricing-bar">
      <p class="pricing-note">Prices are for <%= TelloraPlans.billing_months %> months, billed once every <%= TelloraPlans.billing_months %> months after your free period.</p>
      <% if currency_keys.size > 1 %>
        <div class="currency" role="group" aria-label="Currency">
          <% currency_keys.each_with_index do |code, i| %>
            <button type="button" data-currency="<%= code %>" aria-pressed="<%= i.zero? %>"><%= TelloraPlans.currencies.dig(code, 'label') || code %></button>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="plans">
      <% plans.each do |plan| %>
        <article class="plan<%= ' plan-popular' if plan['popular'] %>" aria-labelledby="plan-<%= plan['key'] %>">
          <% if plan['popular'] %><span class="plan-badge">Most popular</span><% end %>
          <h3 id="plan-<%= plan['key'] %>"><%= plan['name'] %></h3>
          <p class="plan-for"><%= plan['for'] %></p>
          <% if plan['contact'] %>
            <p class="plan-trial">&nbsp;</p>
            <p class="plan-contact">Let's talk</p>
            <p class="plan-monthly">Custom price for your business</p>
          <% else %>
            <p class="plan-trial">Free for <%= TelloraPlans.trial_months %> months, then</p>
            <% currency_keys.each_with_index do |code, i| %>
              <div data-price="<%= code %>"<%= ' hidden' unless i.zero? %>>
                <p class="plan-price"><%= TelloraPlans.price_label(plan, code) %> <small>/ <%= TelloraPlans.billing_months %> months</small></p>
                <p class="plan-monthly">About <%= TelloraPlans.monthly_label(plan, code) %> a month</p>
              </div>
            <% end %>
          <% end %>
          <ul>
            <% Array(plan['highlights']).each do |item| %>
              <li><%= item %></li>
            <% end %>
          </ul>
          <% if plan['contact'] %>
            <a class="button" href="mailto:<%= TelloraPlans.contact_email %>?subject=<%= ERB::Util.url_encode("#{platform_name} Enterprise") %>">Contact us</a>
          <% else %>
            <a class="button" href="#build" data-start-free>Start free</a>
          <% end %>
        </article>
      <% end %>
    </div>

    <div class="compare-wrap" role="region" aria-labelledby="compare-caption" tabindex="0">
      <table class="compare">
        <caption id="compare-caption">Compare plans</caption>
        <thead>
          <tr>
            <th scope="col"><span class="sr-only" style="position:absolute;left:-999px">Feature</span></th>
            <% plans.each do |plan| %><th scope="col"><%= plan['name'] %></th><% end %>
          </tr>
        </thead>
        <tbody>
          <% TelloraPlans.compare.each do |row| %>
            <tr>
              <th scope="row"><%= row['label'] %></th>
              <% plans.each do |plan| %>
                <% value = row[plan['key']] %>
                <td>
                  <% if value == true %><span class="yes" role="img" aria-label="Included"></span>
                  <% elsif value == false || value.nil? %><span aria-label="Not included">–</span>
                  <% else %><%= value %><% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="free-all">
      <h3>Included free in every plan</h3>
      <p>No add-ons to buy and no extra charges for the basics.</p>
      <div class="free-grid">
        <% TelloraPlans.included.each do |group| %>
          <section aria-label="<%= group['title'] %>">
            <h4><%= group['title'] %></h4>
            <ul>
              <% Array(group['items']).each do |item| %><li><%= item %></li><% end %>
            </ul>
          </section>
        <% end %>
      </div>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="anywhere-title">
  <div class="wrap anywhere">
