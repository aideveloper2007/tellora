<% preview_domain = TenantResolver.platform_domains.first || request.host %>
<% plans = TelloraPlans.plans %>
<% currency_keys = TelloraPlans.currencies.keys %>
<% content_for :head do %>
<style>
  /* ---------- Hero ---------- */
  .hero { position: relative; overflow: hidden; background: var(--ink); color: var(--text-dark); padding: clamp(3.5rem, 8vw, 6.5rem) 0 clamp(3.5rem, 7vw, 5.5rem); }
  .hero::before { content: ''; position: absolute; inset: 0; background-image: linear-gradient(var(--line-dark) 1px, transparent 1px), linear-gradient(90deg, var(--line-dark) 1px, transparent 1px); background-size: 56px 56px; -webkit-mask-image: radial-gradient(ellipse 70% 60% at 70% 40%, #000 20%, transparent 75%); mask-image: radial-gradient(ellipse 70% 60% at 70% 40%, #000 20%, transparent 75%); opacity: 0.55; }
  .glow { position: absolute; width: 46rem; height: 46rem; right: -10rem; top: -8rem; background: radial-gradient(circle, rgba(255,90,31,.38), rgba(255,138,61,.12) 40%, transparent 68%); filter: blur(10px); pointer-events: none; animation: breathe 7s ease-in-out infinite; }
  @keyframes breathe { 50% { transform: scale(1.08); opacity: .8; } }
  .hero > .wrap { position: relative; display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .eyebrow { display: inline-flex; align-items: center; gap: .55rem; padding: .4rem .8rem .4rem .45rem; border-radius: 999px; border: 1px solid var(--line-dark); background: rgba(255,255,255,.04); font-size: .82rem; color: var(--muted-dark); }
  .eyebrow b { background: rgba(255,90,31,.16); color: var(--ember-2); font-weight: 600; padding: .2rem .55rem; border-radius: 999px; font-size: .75rem; }
  .hero h1 { margin-top: 1.4rem; font-size: clamp(2.5rem, 5vw, 4.25rem); line-height: 1; font-weight: 800; }
  .hero h1 em { font-style: normal; background: linear-gradient(120deg, var(--ember) 10%, var(--ember-2) 60%, #ffc27a); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .lede { margin-top: 1.4rem; font-size: clamp(1.05rem, 1.6vw, 1.2rem); line-height: 1.55; color: var(--muted-dark); max-width: 33rem; }

  .prompt { margin-top: 2rem; background: var(--ink-2); border: 1px solid var(--line-dark); border-radius: 20px; padding: .6rem; box-shadow: 0 30px 60px -30px rgba(0,0,0,.8); transition: border-color .2s, box-shadow .2s; }
  .prompt:focus-within { border-color: rgba(255,90,31,.55); box-shadow: 0 0 0 4px rgba(255,90,31,.12), 0 30px 60px -30px rgba(0,0,0,.8); }
  .prompt label { position: absolute; left: -9999px; }
  .prompt textarea { width: 100%; min-height: 5.2rem; resize: none; background: transparent; border: 0; outline: 0; color: var(--text-dark); font: 400 1.05rem/1.5 var(--font-body); padding: .7rem .8rem 0; }
  .prompt textarea::placeholder { color: #6e6c7a; }
  .prompt-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .3rem .2rem .2rem .8rem; }
  .prompt-row span { font-size: .8rem; color: #6e6c7a; }
  .hero .flash { margin: 1.5rem 0 0; }
  .chips { display: flex; flex-wrap: wrap; gap: .5rem; margin: 1rem 0 0; padding: 0; list-style: none; }
  .chip { border: 1px solid var(--line-dark); background: transparent; color: var(--muted-dark); font: 500 .82rem var(--font-body); padding: .5rem .8rem; border-radius: 999px; cursor: pointer; transition: all .15s; }
  .chip:hover, .chip[aria-pressed="true"] { color: #fff; border-color: rgba(255,255,255,.3); }

  /* ---------- Store machine ---------- */
  .machine { position: relative; padding-top: 4.6rem; }
  .browser { position: relative; background: #fff; border-radius: 16px; overflow: hidden; box-shadow: 0 50px 100px -30px rgba(0,0,0,.9), 0 0 0 1px rgba(255,255,255,.08), 0 0 80px -20px rgba(255,90,31,.35); }
  .bbar { display: flex; align-items: center; gap: .8rem; padding: .7rem .9rem; background: #f1efec; border-bottom: 1px solid #e4e0da; }
  .dots { display: flex; gap: .35rem; } .dots span { width: .65rem; height: .65rem; border-radius: 50%; background: #d5d0c8; }
  .url { flex: 1; min-width: 0; display: flex; align-items: center; gap: .45rem; background: #fff; border-radius: 8px; padding: .38rem .7rem; font-size: .78rem; color: #55524d; }
  .url span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .url .lock { flex: none; width: .7rem; height: .7rem; border-radius: 2px; background: var(--live); opacity: 0; transition: opacity .3s; }
  .url.secure .lock { opacity: 1; }
  .live-badge { font: 700 .68rem var(--font-body); letter-spacing: .06em; color: #fff; background: var(--live); padding: .3rem .55rem; border-radius: 999px; opacity: 0; transform: scale(.6); transition: all .35s cubic-bezier(.2,1.6,.4,1); }
  .live-badge.on { opacity: 1; transform: scale(1); }

  .store { --s-bg: #f4ede3; --s-ink: #2a1a12; --s-accent: #9c3b1f; --s-font: Georgia, serif; --s-hero: linear-gradient(120deg,#5a3220,#b87445 60%,#e6b886); --s-p1: linear-gradient(150deg,#c98b5b,#6b3a22); --s-p2: linear-gradient(150deg,#e2c3a0,#a06a43); --s-p3: linear-gradient(150deg,#7e5639,#3a2216);
    background: var(--s-bg); color: var(--s-ink); height: 25.5rem; padding: 1rem 1.2rem; display: grid; grid-template-rows: auto auto 1fr; gap: .9rem; transition: background .5s, color .5s; }
  .s-head { display: flex; align-items: center; justify-content: space-between; }
  .s-logo { font: 500 1.15rem var(--s-font); letter-spacing: -.01em; }
  .s-nav { display: flex; gap: .9rem; font-size: .7rem; opacity: .7; }
  .s-hero { position: relative; border-radius: 10px; height: 9.5rem; background: var(--s-hero); overflow: hidden; display: flex; flex-direction: column; justify-content: flex-end; padding: 1rem; color: #fff; }
  .s-hero::after { content: ''; position: absolute; right: -2rem; top: -2rem; width: 10rem; height: 10rem; border-radius: 50%; background: rgba(255,255,255,.14); }
  .s-hero h4 { position: relative; z-index: 1; font: 500 1.35rem/1.1 var(--s-font); letter-spacing: 0; max-width: 17rem; }
  .s-hero span { position: relative; z-index: 1; margin-top: .6rem; align-self: flex-start; font-size: .66rem; font-weight: 600; background: #fff; color: var(--s-accent); padding: .38rem .7rem; border-radius: 999px; }
  .s-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: .7rem; }
  .s-card { display: flex; flex-direction: column; gap: .35rem; }
  .s-img { border-radius: 8px; flex: 1; min-height: 5.5rem; position: relative; overflow: hidden; }
  .s-img::after { content: ''; position: absolute; left: 50%; top: 52%; width: 42%; aspect-ratio: 1; transform: translate(-50%,-50%); border-radius: 30% 30% 40% 40%; background: rgba(255,255,255,.22); box-shadow: inset 0 -8px 16px rgba(0,0,0,.12); }
  .s-card:nth-child(1) .s-img { background: var(--s-p1); } .s-card:nth-child(2) .s-img { background: var(--s-p2); } .s-card:nth-child(3) .s-img { background: var(--s-p3); }
  .s-name { font-size: .68rem; font-weight: 600; }
  .s-price { font-size: .66rem; color: var(--s-accent); font-weight: 700; }
  .machine .store [data-step] { opacity: 0; transform: translateY(10px) scale(.98); filter: blur(4px); transition: opacity .5s ease, transform .5s ease, filter .5s ease; }
  .machine .store [data-step].in { opacity: 1; transform: none; filter: none; }
  .scan { position: absolute; left: 0; right: 0; height: 2px; top: 3rem; background: linear-gradient(90deg, transparent, var(--ember), transparent); box-shadow: 0 0 16px var(--ember); opacity: 0; }
  .scan.run { animation: scan 2.4s ease-in-out; }
  @keyframes scan { 0% { top: 3rem; opacity: 0; } 10% { opacity: 1; } 90% { opacity: 1; } 100% { top: 100%; opacity: 0; } }

  .log { z-index: 3; position: absolute; left: -3rem; bottom: -3.2rem; width: 17rem; background: rgba(20,20,27,.92); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); border: 1px solid var(--line-dark); border-radius: 14px; padding: .9rem 1rem; color: var(--text-dark); box-shadow: 0 30px 60px -20px rgba(0,0,0,.8); font-size: .8rem; }
  .log-top { display: flex; justify-content: space-between; color: var(--muted-dark); font-size: .72rem; margin-bottom: .55rem; }
  .log-top b { color: var(--ember-2); font-variant-numeric: tabular-nums; }
  .log ol { list-style: none; margin: 0; padding: 0; display: grid; gap: .38rem; }
  .log li { display: flex; align-items: center; gap: .55rem; color: #6e6c7a; transition: color .3s; }
  .log li::before { content: ''; width: .85rem; height: .85rem; border-radius: 50%; border: 1.5px solid #3a3a46; flex: none; transition: all .3s; }
  .log li.active { color: #fff; } .log li.active::before { border-color: var(--ember); border-top-color: transparent; animation: spin .8s linear infinite; }
  .log li.done { color: var(--text-dark); } .log li.done::before { background: var(--live); border-color: var(--live); box-shadow: inset 0 0 0 2.5px var(--ink-2); }
  @keyframes spin { to { transform: rotate(360deg); } }
  .typing { z-index: 3; position: absolute; left: -1rem; top: 0; max-width: 18rem; background: var(--ink-2); border: 1px solid rgba(255,90,31,.4); color: var(--text-dark); border-radius: 12px 12px 12px 4px; padding: .65rem .85rem; font-size: .8rem; line-height: 1.4; box-shadow: 0 20px 40px -15px rgba(0,0,0,.8); }
  .typing small { display: block; color: var(--ember-2); font-weight: 600; font-size: .68rem; margin-bottom: .2rem; letter-spacing: .04em; text-transform: uppercase; }
  .caret { display: inline-block; width: 2px; height: 1em; background: var(--ember); vertical-align: -2px; margin-left: 1px; animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  /* ---------- Proof strip ---------- */
  .proof { background: var(--ink); border-top: 1px solid var(--line-dark); color: var(--muted-dark); }
  .proof .wrap { display: grid; grid-template-columns: repeat(5, 1fr); }
  .proof div { padding: 1.4rem 1rem; border-left: 1px solid var(--line-dark); text-align: center; font-size: .85rem; }
  .proof div:first-child { border-left: 0; }
  .proof strong { display: block; color: #fff; font: 700 1.35rem var(--font-display); margin-bottom: .2rem; letter-spacing: -.02em; }

  /* ---------- Sections ---------- */
  .section { padding: clamp(4.5rem, 9vw, 7.5rem) 0; background: var(--paper); }
  .section-dark { background: var(--ink); color: var(--text-dark); }
  .section-sand { background: var(--mist); }
  .kicker { font-size: .8rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--ember); }
  .section h2 { margin-top: .8rem; font-size: clamp(2.1rem, 4.4vw, 3.4rem); line-height: 1.02; font-weight: 800; max-width: 46rem; }
  .intro { margin-top: 1.1rem; font-size: 1.12rem; line-height: 1.6; color: var(--muted); max-width: 40rem; }
  .section-dark .intro { color: var(--muted-dark); }

  /* pipeline */
  .pipe { margin: 3.5rem 0 0; padding: 0; position: relative; display: grid; grid-template-columns: repeat(8, 1fr); gap: .8rem; }
  .pipe::before { content: ''; position: absolute; top: 1.7rem; left: 4%; right: 4%; height: 2px; background: var(--line); }
  .pipe::after { content: ''; position: absolute; top: 1.7rem; left: 4%; height: 2px; width: 0; background: linear-gradient(90deg, var(--ember), var(--ember-2)); box-shadow: 0 0 12px rgba(255,90,31,.6); transition: width 2.6s cubic-bezier(.6,0,.2,1); }
  .pipe.go::after { width: 92%; }
  .pipe li { list-style: none; position: relative; text-align: center; }
  .pipe .node { position: relative; z-index: 1; margin: 0 auto; width: 3.4rem; height: 3.4rem; border-radius: 14px; background: #fff; border: 1px solid var(--line); display: grid; place-items: center; box-shadow: 0 8px 20px -12px rgba(0,0,0,.25); transition: all .4s; }
  .pipe .node svg { width: 1.35rem; height: 1.35rem; stroke: var(--ink); fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; transition: stroke .4s; }
  .pipe.go li .node { border-color: rgba(255,90,31,.5); background: #fff4ee; }
  .pipe.go li .node svg { stroke: var(--ember); }
  .pipe li:nth-child(2) .node { transition-delay: .3s } .pipe li:nth-child(3) .node { transition-delay: .6s } .pipe li:nth-child(4) .node { transition-delay: .9s }
  .pipe li:nth-child(5) .node { transition-delay: 1.2s } .pipe li:nth-child(6) .node { transition-delay: 1.5s } .pipe li:nth-child(7) .node { transition-delay: 1.8s } .pipe li:nth-child(8) .node { transition-delay: 2.1s }
  .pipe li:last-child .node, .pipe.go li:last-child .node { background: var(--ink); border-color: var(--ink); }
  .pipe li:last-child .node svg, .pipe.go li:last-child .node svg { stroke: var(--live); }
  .pipe h3 { margin-top: 1rem; font-size: 1rem; font-weight: 700; letter-spacing: -.01em; }
  .pipe p { margin-top: .35rem; font-size: .84rem; line-height: 1.45; color: var(--muted); }

  /* designs */
  .tabs { margin-top: 2.5rem; display: inline-flex; gap: .35rem; padding: .35rem; background: var(--ink-2); border: 1px solid var(--line-dark); border-radius: 999px; }
  .tab { border: 0; cursor: pointer; background: transparent; color: var(--muted-dark); font: 600 .9rem var(--font-body); padding: .7rem 1.2rem; border-radius: 999px; transition: all .2s; }
  .tab[aria-selected="true"] { background: #fff; color: var(--ink); }
  .show { margin-top: 2rem; display: grid; grid-template-columns: 1.6fr 1fr; gap: 2rem; align-items: center; }
  .show .store { height: 27rem; }
  .show-copy h3 { font-size: 2rem; font-weight: 800; }
  .show-copy p { margin-top: 1rem; color: var(--muted-dark); line-height: 1.6; font-size: 1.02rem; }
  .show-copy ul { margin: 1.4rem 0 0; padding: 0; list-style: none; display: grid; gap: .6rem; }
  .show-copy li { display: flex; gap: .6rem; align-items: center; color: var(--text-dark); font-size: .95rem; }
  .show-copy li::before { content: ''; width: .45rem; height: .45rem; border-radius: 50%; background: var(--ember); box-shadow: 0 0 10px var(--ember); }
  .swatches { display: flex; gap: .45rem; margin-top: 1.5rem; } .swatches span { width: 2.1rem; height: 2.1rem; border-radius: 10px; border: 1px solid var(--line-dark); }

  /* features */
  .bento { margin-top: 3.2rem; display: grid; grid-template-columns: repeat(6, 1fr); gap: 1rem; }
  .cell { background: #fff; border: 1px solid var(--line); border-radius: 22px; padding: 1.7rem; position: relative; overflow: hidden; transition: transform .25s, box-shadow .25s; }
  .cell:hover { transform: translateY(-3px); box-shadow: 0 24px 50px -28px rgba(0,0,0,.25); }
  .cell h3 { font-size: 1.25rem; font-weight: 700; letter-spacing: -.015em; }
  .cell p { margin-top: .55rem; color: var(--muted); line-height: 1.55; font-size: .95rem; }
  .ico { width: 2.6rem; height: 2.6rem; border-radius: 12px; background: #fff1ea; display: grid; place-items: center; margin-bottom: 1.2rem; }
  .ico svg { width: 1.25rem; height: 1.25rem; stroke: var(--ember); fill: none; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
  .c-wide { grid-column: span 3; } .c-third { grid-column: span 2; }
  .c-dark { background: var(--ink); border-color: var(--ink); color: var(--text-dark); }
  .c-dark p { color: var(--muted-dark); } .c-dark .ico { background: rgba(255,90,31,.15); }
  .pills { display: flex; flex-wrap: wrap; gap: .45rem; margin-top: 1.2rem; }
  .pills span { font-size: .78rem; font-weight: 600; padding: .45rem .75rem; border-radius: 999px; background: var(--mist); color: var(--ink); }
  .chat { margin-top: 1.2rem; display: grid; gap: .5rem; }
  .chat div { font-size: .82rem; padding: .6rem .8rem; border-radius: 12px; max-width: 85%; }
  .chat .me { justify-self: end; background: linear-gradient(135deg, var(--ember), var(--ember-2)); color: #fff; border-bottom-right-radius: 4px; }
  .chat .ai { background: rgba(255,255,255,.07); color: var(--text-dark); border-bottom-left-radius: 4px; }
  .domain { margin-top: 1.2rem; display: flex; align-items: center; gap: .6rem; font-size: .85rem; flex-wrap: wrap; }
  .domain code { font-family: var(--font-body); background: var(--mist); padding: .45rem .7rem; border-radius: 8px; }
  .domain .arrow { color: var(--ember); font-weight: 700; }
  .domain .ok { color: #148a4e; font-weight: 600; }

  /* pricing */
  .trial { margin-top: 2.5rem; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; background: var(--ink); color: var(--text-dark); border-radius: 22px; padding: 1.6rem 1.9rem; position: relative; overflow: hidden; }
  .trial::after { content: ''; position: absolute; right: -6rem; top: -6rem; width: 18rem; height: 18rem; background: radial-gradient(circle, rgba(255,90,31,.45), transparent 65%); }
  .trial > * { position: relative; z-index: 1; }
  .trial strong { font: 800 1.6rem var(--font-display); letter-spacing: -.02em; }
  .trial p { color: var(--muted-dark); margin-top: .3rem; }
  .pricing-bar { margin-top: 2rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .pricing-note { color: var(--muted); font-size: .9rem; }
  .currency { display: inline-flex; gap: .25rem; padding: .3rem; background: #fff; border: 1px solid var(--line); border-radius: 999px; }
  .currency button { border: 0; cursor: pointer; background: transparent; font: 600 .85rem var(--font-body); padding: .5rem .9rem; border-radius: 999px; color: var(--muted); }
  .currency button[aria-pressed="true"] { background: var(--ink); color: #fff; }
  .plans { margin-top: 1.4rem; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .plan { background: #fff; border: 1px solid var(--line); border-radius: 22px; padding: 1.7rem; display: flex; flex-direction: column; position: relative; }
  .plan-popular { border: 2px solid var(--ember); box-shadow: 0 30px 60px -30px rgba(255,90,31,.45); }
  .plan-badge { position: absolute; top: -.8rem; left: 1.5rem; background: linear-gradient(135deg, var(--ember), var(--ember-2)); color: #fff; font-size: .72rem; font-weight: 700; padding: .32rem .7rem; border-radius: 999px; }
  .plan h3 { font-size: 1.3rem; font-weight: 700; }
  .plan-for { color: var(--muted); font-size: .88rem; margin-top: .3rem; }
  .plan-trial { margin-top: 1.2rem; font-size: .8rem; color: var(--ember); font-weight: 600; }
  .plan-price, .plan-contact { margin-top: .2rem; font: 800 2.1rem var(--font-display); letter-spacing: -.03em; }
  .plan-price small { font: 500 .85rem var(--font-body); color: var(--muted); letter-spacing: 0; }
  .plan-monthly { font-size: .82rem; color: var(--muted); margin-top: .2rem; }
  .plan ul { list-style: none; padding: 0; margin: 1.3rem 0 1.6rem; display: grid; gap: .6rem; font-size: .9rem; flex: 1; align-content: start; }
  .plan li { display: flex; gap: .55rem; line-height: 1.4; } .plan li::before { content: '✓'; color: var(--ember); font-weight: 700; }

  .compare-wrap { margin-top: 3rem; overflow-x: auto; background: #fff; border: 1px solid var(--line); border-radius: 22px; }
  .compare { width: 100%; border-collapse: collapse; font-size: .9rem; min-width: 40rem; }
  .compare caption { text-align: left; padding: 1.4rem 1.5rem .4rem; font: 700 1.25rem var(--font-display); letter-spacing: -.015em; }
  .compare th, .compare td { padding: .85rem 1.5rem; text-align: left; border-bottom: 1px solid var(--line); }
  .compare thead th { font-weight: 700; color: var(--ink); }
  .compare tbody th { font-weight: 500; color: var(--muted); }
  .compare tr:last-child th, .compare tr:last-child td { border-bottom: 0; }
  .compare .yes { display: inline-block; width: 1.1rem; height: 1.1rem; border-radius: 50%; background: var(--ember); position: relative; }
  .compare .yes::after { content: ''; position: absolute; left: .38rem; top: .2rem; width: .3rem; height: .55rem; border: solid #fff; border-width: 0 2px 2px 0; transform: rotate(45deg); }

  .free-all { margin-top: 3rem; }
  .free-all h3 { font-size: 1.6rem; font-weight: 800; }
  .free-all > p { margin-top: .4rem; color: var(--muted); }
  .free-grid { margin-top: 1.5rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1rem; }
  .free-grid section { background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 1.3rem 1.4rem; }
  .free-grid h4 { font-size: 1.05rem; font-weight: 700; letter-spacing: -.01em; }
  .free-grid ul { list-style: none; padding: 0; margin: .8rem 0 0; display: grid; gap: .5rem; font-size: .88rem; color: var(--muted); }
  .free-grid li { position: relative; padding-left: 1rem; line-height: 1.45; }
  .free-grid li::before { content: ''; position: absolute; left: 0; top: .5rem; width: .4rem; height: .4rem; border-radius: 50%; background: var(--ember); }

  /* faq */
  .faq { margin-top: 2.5rem; display: grid; gap: .7rem; max-width: 52rem; }
  .faq details { background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 1.15rem 1.4rem; }
  .faq summary { cursor: pointer; font-weight: 600; font-size: 1.02rem; list-style: none; display: flex; justify-content: space-between; gap: 1rem; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; color: var(--ember); font-size: 1.3rem; line-height: 1; transition: transform .2s; }
  .faq details[open] summary::after { transform: rotate(45deg); }
  .faq details p { margin-top: .8rem; color: var(--muted); line-height: 1.6; }

  /* closing */
  .closing { position: relative; overflow: hidden; text-align: center; }
  .closing .glow { left: 50%; right: auto; top: 30%; margin-left: -23rem; }
  .closing .wrap { position: relative; }
  .closing h2 { margin-left: auto; margin-right: auto; }
  .closing .intro { margin-left: auto; margin-right: auto; }
  .closing .button { margin-top: 2.2rem; padding: 1.1rem 1.7rem; font-size: 1rem; }

  /* reveal on scroll */
  .js .reveal { opacity: 0; transform: translateY(24px); transition: opacity .8s ease, transform .8s ease; }
  .js .reveal.seen { opacity: 1; transform: none; }

  @media (max-width: 1000px) {
    .hero > .wrap, .show { grid-template-columns: 1fr; }
    .machine { margin: 1.5rem 1.5rem 2.5rem; }
    .pipe { grid-template-columns: repeat(4, 1fr); row-gap: 2rem; } .pipe::before, .pipe::after { display: none; }
    .plans { grid-template-columns: repeat(2, 1fr); }
    .c-wide, .c-third { grid-column: span 3; }
  }
  @media (max-width: 640px) {
    .proof .wrap { grid-template-columns: repeat(2, 1fr); } .proof div:nth-child(odd) { border-left: 0; } .proof div:last-child { grid-column: span 2; }
    .pipe { grid-template-columns: repeat(2, 1fr); }
    .plans { grid-template-columns: 1fr; }
    .bento { grid-template-columns: 1fr; } .c-wide, .c-third { grid-column: auto; }
    .machine { margin: 1.5rem .2rem 3.5rem; }
    .log { left: .5rem; bottom: -3rem; width: 14.5rem; } .typing { left: .3rem; }
    .s-grid { grid-template-columns: repeat(2, 1fr); } .s-card:nth-child(3) { display: none; }
    .tabs { display: flex; flex-wrap: wrap; border-radius: 18px; }
    .prompt-row { flex-direction: column; align-items: stretch; } .prompt-row .button { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) { .js .reveal { opacity: 1; transform: none; } }
</style>
<% end %>

<!-- ============ HERO ============ -->
<section class="hero" id="build" aria-labelledby="hero-title">
  <div class="glow" aria-hidden="true"></div>
  <div class="wrap">
    <div>
      <span class="eyebrow"><b>New</b> AI that builds complete online stores</span>
      <h1 id="hero-title">Describe it.<br><em>Tellora builds&nbsp;it.</em></h1>
      <p class="lede">One sentence in, a live store out. Tellora writes, designs, stocks and launches your online store in about a minute, with payments, SSL and your own domain ready.</p>

      <% if flash[:alert] %><p class="flash" role="alert"><%= flash[:alert] %></p><% end %>

      <%= form_with url: platform_start_path, method: :post, id: 'build-form', class: 'prompt', data: { turbo: false } do %>
        <label for="prompt">What does your business sell?</label>
        <textarea id="prompt" name="prompt" maxlength="500" required
                  placeholder="Handmade leather bags from Florence, for people who travel light"><%= @prompt %></textarea>
        <div class="prompt-row">
          <span>Any language · Change anything later by chatting</span>
          <button type="submit" class="button">Build my store →</button>
        </div>
      <% end %>
      <ul class="chips" id="chips" aria-label="Example businesses"></ul>
    </div>

    <div class="machine" role="img" aria-label="Animation: Tellora building an example store">
      <div class="typing" aria-hidden="true"><small>You type</small><span id="type-text"></span><span class="caret"></span></div>
      <div class="browser" aria-hidden="true">
        <div class="bbar">
          <div class="dots"><span></span><span></span><span></span></div>
          <div class="url" id="m-url"><i class="lock"></i><span id="m-host">building…</span></div>
          <span class="live-badge" id="m-live">● LIVE</span>
        </div>
        <div class="store" id="m-store">
          <div class="s-head" data-step="1"><span class="s-logo" id="m-logo"></span><span class="s-nav"><span>Shop</span><span>Story</span><span>Cart (0)</span></span></div>
