<!-- ============ PRICING ============ -->
<section class="section section-sand" id="pricing" aria-labelledby="pricing-title">
  <div class="wrap">
    <p class="kicker reveal">Pricing</p>
    <h2 class="reveal" id="pricing-title"><%= TelloraPlans.trial_months %> months free. Every feature.</h2>
    <p class="intro reveal">Build your store and sell for <%= TelloraPlans.trial_months %> months without paying anything, with every feature switched on. After that, choose the plan that fits and pay every <%= TelloraPlans.billing_months %> months.</p>

    <div class="trial reveal">
      <div><strong>Every store starts with <%= TelloraPlans.trial_months %> months free</strong><p>All features, all payment gateways, SEO and SSL. No card needed. 0% fees on your sales.</p></div>
      <a class="button" href="#build" data-start-free>Build my store →</a>
    </div>

    <div class="pricing-bar">
      <p class="pricing-note">Prices are for <%= TelloraPlans.billing_months %> months, billed once every <%= TelloraPlans.billing_months %> months after your free period.</p>
      <% if currency_keys.size > 1 %>
        <div class="currency" role="group" aria-label="Currency">
          <% currency_keys.each_with_index do |code, i| %>
            <button type="button" data-currency="<%= code %>" aria-pressed="<%= i.zero? %>"><%= TelloraPlans.currencies.dig(code, 'label') || code %></button>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="plans">
      <% plans.each do |plan| %>
        <article class="plan<%= ' plan-popular' if plan['popular'] %>" aria-labelledby="plan-<%= plan['key'] %>">
          <% if plan['popular'] %><span class="plan-badge">Most popular</span><% end %>
          <h3 id="plan-<%= plan['key'] %>"><%= plan['name'] %></h3>
          <p class="plan-for"><%= plan['for'] %></p>
          <% if plan['contact'] %>
            <p class="plan-trial">&nbsp;</p>
            <p class="plan-contact">Let's talk</p>
            <p class="plan-monthly">Custom price for your business</p>
          <% else %>
            <p class="plan-trial">Free for <%= TelloraPlans.trial_months %> months, then</p>
            <% currency_keys.each_with_index do |code, i| %>
              <div data-price="<%= code %>"<%= ' hidden' unless i.zero? %>>
                <p class="plan-price"><%= TelloraPlans.price_label(plan, code) %> <small>/ <%= TelloraPlans.billing_months %> months</small></p>
                <p class="plan-monthly">About <%= TelloraPlans.monthly_label(plan, code) %> a month</p>
              </div>
            <% end %>
          <% end %>
          <ul>
            <% Array(plan['highlights']).each do |item| %>
              <li><%= item %></li>
            <% end %>
          </ul>
          <% if plan['contact'] %>
            <a class="button button-quiet" href="mailto:<%= TelloraPlans.contact_email %>?subject=<%= ERB::Util.url_encode("#{platform_name} Enterprise") %>">Contact us</a>
          <% else %>
            <a class="button<%= ' button-quiet' unless plan['popular'] %>" href="#build" data-start-free>Start free</a>
          <% end %>
        </article>
      <% end %>
    </div>

    <div class="compare-wrap" role="region" aria-labelledby="compare-caption" tabindex="0">
      <table class="compare">
        <caption id="compare-caption">Compare plans</caption>
        <thead>
          <tr>
            <th scope="col"><span style="position:absolute;left:-9999px">Feature</span></th>
            <% plans.each do |plan| %><th scope="col"><%= plan['name'] %></th><% end %>
          </tr>
        </thead>
        <tbody>
          <% TelloraPlans.compare.each do |row| %>
            <tr>
              <th scope="row"><%= row['label'] %></th>
              <% plans.each do |plan| %>
                <% value = row[plan['key']] %>
                <td>
                  <% if value == true %><span class="yes" role="img" aria-label="Included"></span>
                  <% elsif value == false || value.nil? %><span aria-label="Not included">–</span>
                  <% else %><%= value %><% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="free-all">
      <h3>Included free in every plan</h3>
      <p>No add-ons to buy and no extra charges for the basics.</p>
      <div class="free-grid">
        <% TelloraPlans.included.each do |group| %>
          <section aria-label="<%= group['title'] %>">
            <h4><%= group['title'] %></h4>
            <ul>
              <% Array(group['items']).each do |item| %><li><%= item %></li><% end %>
            </ul>
          </section>
        <% end %>
      </div>
    </div>
  </div>
</section>

<!-- ============ FAQ ============ -->
<section class="section" id="questions" aria-labelledby="questions-title">
  <div class="wrap">
    <p class="kicker reveal">Questions</p>
    <h2 class="reveal" id="questions-title">Good questions, short answers.</h2>
    <div class="faq">
      <details>
        <summary>Is it really free for <%= TelloraPlans.trial_months %> months?</summary>
        <p>Yes. You get every feature for <%= TelloraPlans.trial_months %> months without paying and without adding a card. Before the free period ends, we remind you to choose a plan. If you don't, your store pauses; nothing is deleted, and choosing a plan brings it back.</p>
      </details>
      <details>
        <summary>How does billing work after the free period?</summary>
        <p>You pay once every <%= TelloraPlans.billing_months %> months for the plan you choose. You can move to a bigger or smaller plan whenever you need to, and there is no fee on your sales on any plan.</p>
      </details>
      <details>
        <summary>What counts as a home page theme change?</summary>
        <p>A new AI design for your home page, or switching to a different style family. Changing your text, photos, products, logo and colours is free and unlimited on every plan.</p>
      </details>
      <details>
        <summary>Do I need design or coding skills?</summary>
        <p>No. You describe your business in your own words and the store is built for you. Later changes work the same way: you ask, and the AI makes them.</p>
      </details>
      <details>
        <summary>Which languages can I use?</summary>
        <p>Any language you can write in. Describe your store in the language that comes naturally; the AI understands it.</p>
      </details>
      <details>
        <summary>Can I use my own domain?</summary>
        <p>Yes. Your store starts on its own address. When you are ready, enter your domain, add the two DNS records Tellora shows you, and it connects with a free SSL certificate.</p>
      </details>
      <details>
        <summary>What happens to the sample products?</summary>
        <p>They are there to show how your store will look. Each one is marked as a sample, so you can delete them all once you add your own products.</p>
      </details>
      <details>
        <summary>Who owns my store's data?</summary>
        <p>You do. Each store's products, orders and customers are kept in their own separate database, apart from every other store on the platform.</p>
      </details>
    </div>
  </div>
</section>

