          <div class="s-grid" id="m-grid"></div>
        </div>
        <div class="scan" id="m-scan"></div>
      </div>
      <div class="log" aria-hidden="true">
        <div class="log-top"><span>Tellora is building</span><b id="m-time">0.0s</b></div>
