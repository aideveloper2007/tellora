<%# Product grid with the family's product card. locals: section, products %>
<% if products.any? %>
<section class="tl-section tl-products" aria-labelledby="tl-products-title">
  <div class="tl-wrap">
    <div class="tl-head">
      <div>
        <h2 id="tl-products-title"><%= section['title'] %></h2>
        <% if section['subtitle'].present? %><p><%= section['subtitle'] %></p><% end %>
      </div>
      <a class="tl-link" href="<%= spree.products_path %>"><%= section['link_label'] %></a>
    </div>
    <div class="tl-grid">
      <% products.each do |product| %>
        <% first_image = product.default_image %>
        <% second_image = product.respond_to?(:secondary_image) ? product.secondary_image : nil %>
        <% second_image = nil if second_image && first_image && second_image.id == first_image.id %>
        <% category = tl_product_category(product) %>
        <% note = tl_product_note(product) %>
        <a class="tl-card" href="<%= spree.product_path(product) %>" data-turbo-frame="_top">
          <div class="tl-card-media">
            <%= render 'storefront_sections/photo', image: first_image, width: 480, height: 600, alt: product.name, label: product.name, klass: 'tl-card-photo' %>
            <% if second_image %>
              <%= render 'storefront_sections/photo', image: second_image, width: 480, height: 600, alt: '', klass: 'tl-card-photo tl-card-photo-alt' %>
            <% end %>
            <span class="tl-card-quick"><span class="tl-btn"><%= section['card_cta'] %></span></span>
          </div>
          <div class="tl-card-body">
            <h3 class="tl-card-title"><%= product.name %></h3>
            <% if category.present? %><p class="tl-card-meta"><%= category %></p><% end %>
            <% if note.present? %><p class="tl-card-note"><%= note %></p><% end %>
            <p class="tl-card-price"><%= tl_price(product) %></p>
          </div>
        </a>
      <% end %>
    </div>
  </div>
</section>
<% end %>
