<% if address.present? %>
  <% cache [*spree_base_cache_scope.call(address), address.user_id] do %>
    <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm hover:shadow-md transition-shadow duration-200">
      <!-- Header with icon -->
      <div class="flex items-start space-x-3 mb-4">
        <div class="flex-shrink-0">
          <svg class="w-5 h-5 text-gray-500 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
        </div>
        <div class="flex-1">
          <h3 class="text-lg font-semibold text-gray-900 mb-1">
            <%= address.full_name %>
          </h3>
          <% unless address.company.blank? %>
            <div class="text-sm text-gray-600 font-medium mb-2">
              <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
              </svg>
              <%= address.company %>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Address Details -->
      <div class="space-y-2 text-gray-700">
        <div class="flex items-start">
          <span class="text-sm leading-relaxed">
            <%= address.street %>
          </span>
        </div>
        
        <div class="flex items-center space-x-1 text-sm">
          <span class="font-medium"><%= address.city %></span>
          <span class="text-gray-400">•</span>
          <span><%= address.state_text %></span>
          <span class="text-gray-400">•</span>
          <span class="font-mono bg-gray-100 px-2 py-1 rounded text-xs">
            <%= address.zipcode %>
          </span>
        </div>
        
        <div class="flex items-center text-sm text-gray-600">
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064"/>
          </svg>
          <span class="font-medium"><%= address.country.try(:iso3) %></span>
        </div>
      </div>

      <!-- User Status Badges -->
      <% if address.user %>
        <div class="flex flex-wrap gap-2 mt-4 pt-4 border-t border-gray-100">
          <% if address.id == address.user.ship_address_id %>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800 border border-blue-200">
              <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10"/>
              </svg>
              <%= Spree.t(:default_shipping_address) %>
            </span>
          <% end %>
          <% if address.id == address.user.bill_address_id %>
            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800 border border-green-200">
              <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
              </svg>
              <%= Spree.t(:default_billing_address) %>
            </span>
          <% end %>
        </div>
      <% else %>
        <div class="mt-4 pt-4 border-t border-gray-100">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700 border border-gray-200">
            <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
            Guest Order
          </span>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>