<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= content_for?(:title) ? yield(:title) : "#{platform_name}: describe it, and your online store is built" %></title>
  <meta name="description" content="Describe your business in one sentence. Tellora writes, designs, stocks and launches your online store in about a minute, with payments, SSL and your own domain.">
  <%= csrf_meta_tags %>
  <link rel="icon" type="image/svg+xml" href="/brand/tellora-icon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png">
  <link rel="apple-touch-icon" href="/brand/tellora-app-icon-512.png">
  <meta name="theme-color" content="#0b0b0f">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      /* Tellora: ink + ember */
      --ink: #0b0b0f;
      --ink-soft: #24242e;
      --ink-2: #14141b;
      --ink-3: #1d1d26;
      --paper: #faf8f5;
      --mist: #f2eee8;
      --line: #e6e1d9;
      --muted: #5f5b56;
      --ember: #ff5a1f;
      --ember-2: #ff8a3d;
      --marigold: #ff5a1f; /* old name, used by other platform pages */
      --live: #2bd07b;
      --danger: #b42318;

      --line-dark: rgba(255, 255, 255, 0.09);
      --text-dark: #f4f2ee;
      --muted-dark: #9a98a6;

      --font-display: 'Bricolage Grotesque', 'Segoe UI', system-ui, sans-serif;
      --font-body: 'Inter', 'Segoe UI', system-ui, sans-serif;

      --step--1: 0.875rem;
      --step-0: 1rem;
      --step-1: 1.2rem;
      --step-2: 1.6rem;
      --step-3: 2.2rem;
      --step-4: clamp(2.3rem, 1.5rem + 2.8vw, 3.7rem);

      --page: 76rem;
      --gutter: clamp(1.1rem, 4vw, 2.5rem);
      --radius-s: 8px;
      --radius-l: 20px;
    }

    *, *::before, *::after { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after { animation: none !important; transition: none !important; }
    }

    body {
      margin: 0;
      background: var(--paper);
      color: var(--ink);
      font-family: var(--font-body);
      font-size: var(--step-0);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    h1, h2, h3, h4 { font-family: var(--font-display); line-height: 1.05; margin: 0; letter-spacing: -0.025em; }
    p { margin: 0; }
    a { color: inherit; }

    :focus-visible { outline: 3px solid var(--ember); outline-offset: 3px; border-radius: 4px; }

    .wrap { max-width: var(--page); margin: 0 auto; padding: 0 var(--gutter); }

    .skip { position: absolute; left: -999px; }
    .skip:focus { left: var(--gutter); top: 0.75rem; background: var(--ember); color: #fff; padding: 0.5rem 0.9rem; z-index: 100; border-radius: 6px; }

    /* Buttons */
    .button {
      display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
      font: 600 0.95rem/1 var(--font-body);
      padding: 0.95rem 1.35rem;
      border-radius: 999px;
      border: 0;
      background: linear-gradient(135deg, var(--ember), var(--ember-2));
      color: #fff;
      box-shadow: 0 8px 28px -10px rgba(255, 90, 31, 0.75), inset 0 1px 0 rgba(255, 255, 255, 0.25);
      text-decoration: none; cursor: pointer;
      white-space: nowrap;
      transition: transform 0.15s ease, box-shadow 0.2s ease;
    }
    .button:hover { transform: translateY(-1px); box-shadow: 0 14px 36px -12px rgba(255, 90, 31, 0.9), inset 0 1px 0 rgba(255, 255, 255, 0.25); }
    .button-quiet { background: #fff; color: var(--ink); border: 1px solid var(--line); box-shadow: none; }
    .button-quiet:hover { background: var(--mist); box-shadow: none; }

    /* Header */
    .site-header {
      position: sticky; top: 0; z-index: 50;
      background: var(--ink);
      border-bottom: 1px solid var(--line-dark);
    }
    .site-header .wrap { display: flex; align-items: center; gap: 2rem; min-height: 4.25rem; }
    .brand { display: inline-flex; align-items: center; gap: 0.55rem; text-decoration: none; color: #fff; font: 800 1.4rem/1 var(--font-display); letter-spacing: -0.03em; }
    .brand i { width: 0.8rem; height: 0.8rem; border-radius: 3px; background: linear-gradient(135deg, var(--ember), var(--ember-2)); transform: rotate(45deg); box-shadow: 0 0 18px rgba(255, 90, 31, 0.7); }
    .site-nav { display: flex; gap: 1.75rem; }
    .site-nav a { text-decoration: none; color: var(--muted-dark); font-weight: 500; font-size: 0.92rem; }
    .site-nav a:hover { color: #fff; }
    .header-cta { margin-left: auto; }
    .header-cta .button { padding: 0.7rem 1.1rem; font-size: 0.88rem; }
    @media (max-width: 900px) { .site-nav { display: none; } }

    /* Flash */
    .flash { background: #fdecea; color: var(--danger); border: 1px solid #f4c7c3; padding: 0.75rem 1rem; border-radius: var(--radius-s); margin-bottom: 1.25rem; }

    /* Footer */
    .site-footer { background: var(--ink); color: #6e6c7a; border-top: 1px solid var(--line-dark); padding: 2rem 0; font-size: var(--step--1); }
    .site-footer .wrap { display: flex; flex-wrap: wrap; gap: 1rem 2rem; justify-content: space-between; align-items: center; }
    .site-footer .brand { font-size: 1.1rem; }
    .site-footer nav { display: flex; gap: 1.5rem; flex-wrap: wrap; }
    .site-footer a { text-decoration: none; }
    .site-footer nav a:hover { color: #fff; }
  </style>
  <%= yield :head %>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="wrap">
      <a class="brand" href="<%= platform_landing_path %>"><i aria-hidden="true"></i><%= platform_name.downcase %></a>
      <nav class="site-nav" aria-label="Main">
        <a href="<%= platform_landing_path(anchor: 'how') %>">How it works</a>
        <a href="<%= platform_landing_path(anchor: 'designs') %>">Designs</a>
        <a href="<%= platform_landing_path(anchor: 'features') %>">Features</a>
        <a href="<%= platform_landing_path(anchor: 'pricing') %>">Pricing</a>
        <a href="<%= platform_landing_path(anchor: 'questions') %>">FAQ</a>
      </nav>
      <div class="header-cta">
        <a class="button" href="<%= platform_landing_path(anchor: 'build') %>">Build my store</a>
      </div>
    </div>
  </header>

  <main id="main">
    <%= yield %>
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <span><span class="brand"><i aria-hidden="true"></i><%= platform_name.downcase %></span> &nbsp;&copy; <%= Time.current.year %></span>
      <nav aria-label="Footer">
        <a href="<%= platform_landing_path(anchor: 'how') %>">How it works</a>
        <a href="<%= platform_landing_path(anchor: 'features') %>">Features</a>
        <a href="<%= platform_landing_path(anchor: 'pricing') %>">Pricing</a>
        <a href="<%= platform_landing_path(anchor: 'questions') %>">FAQ</a>
        <a href="mailto:<%= TelloraPlans.contact_email %>"><%= TelloraPlans.contact_email %></a>
      </nav>
    </div>
  </footer>
</body>
</html>