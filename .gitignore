# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# Ignore bundler config.
/.bundle

# Ignore all environment files (except templates), in every folder.
/.env*
!/.env*.erb
.env
.env.*
!.env.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key
/config/credentials/*.key

/app/assets/builds/*
!/app/assets/builds/.keep

# Database backups and dumps
/backups
*.sql
*.dump

# Python (genai_theme_api, python_service)
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Node
node_modules/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp